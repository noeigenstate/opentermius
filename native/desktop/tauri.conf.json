{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenTermius",
  "version": "0.8.1",
  "identifier": "app.opentermius.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../web", "wait": false },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../web" }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenTermius",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": true,
        "create": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "publisher": "OpenTermius",
    "shortDescription": "OpenTermius SSH and SFTP client",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
