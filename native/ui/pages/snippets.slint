import { ListView } from "std-widgets.slint";
import { Theme, Action, IconButton, Field, TextArea, Card, ListRow, PageHeader, PageToolbar, EmptyState, DetailPanel, Caption, Popover, MenuItem } from "../common.slint";

export struct SnippetRow {
    id: string,
    name: string,
    preview: string,
    tags: string,
    updated: string,
}

// Rust reads and drives this page through the global bridge.
export global SnippetsBridge {
    in-out property <[SnippetRow]> snippets;
    in-out property <string> query;
    in-out property <bool> editing;
    in-out property <string> draft-id;
    in-out property <string> draft-name;
    in-out property <string> draft-script;
    in-out property <string> draft-tags;
    in-out property <string> error-text;
    callback search(string);
    callback create;
    callback edit(string);
    callback save(string, string, string);
    callback delete(string);
    callback cancel;
    callback run(string);
}

// Keep the first command in monospace while using the shared row interaction states.
component SnippetItem inherits Rectangle {
    in property <SnippetRow> snippet;
    height: Theme.row-height;
    row := ListRow {
        height: parent.height;
        selected: SnippetsBridge.editing && SnippetsBridge.draft-id == root.snippet.id;
        clicked => { SnippetsBridge.edit(root.snippet.id); }
    }
    HorizontalLayout { padding-left: Theme.space-12; padding-right: Theme.space-12; spacing: Theme.space-12; cross-axis-alignment: center;
        VerticalLayout { horizontal-stretch: 1; spacing: Theme.space-4;
            Text { text: root.snippet.name; color: Theme.text; font-size: Theme.font-body; font-weight: 500; overflow: elide; }
            Text { text: root.snippet.preview; color: Theme.secondary; font-family: Theme.mono-font; font-size: Theme.font-caption; overflow: elide; }
        }
        IconButton {
            button-size: Theme.button-s;
            icon: @image-url("../icons/play.svg");
            visible: row.hovered || self.hovered || row.selected;
            accessible-role: button;
            accessible-label: @tr("Run snippet");
            clicked => { SnippetsBridge.run(root.snippet.id); }
        }
    }
}

export component SnippetsPage inherits Rectangle {
    background: Theme.base;
    property <bool> delete-menu-open: false;
    HorizontalLayout { spacing: 0px;
        VerticalLayout { spacing: 0px; horizontal-stretch: 1;
            PageHeader {
                placeholder: @tr("Search snippets");
                search <=> SnippetsBridge.query;
                primary-text: @tr("New snippet");
                primary-has-icon: true;
                primary-icon: @image-url("../icons/plus.svg");
                search-changed => { SnippetsBridge.search(self.search); }
                search-accepted => { SnippetsBridge.search(self.search); }
                primary-clicked => { SnippetsBridge.create(); }
            }
            PageToolbar {
                Action { kind: "flat"; text: @tr("Import"); disabled: true; }
                Rectangle { horizontal-stretch: 1; }
                Caption { text: SnippetsBridge.snippets.length == 1 ? @tr("1 snippet") : SnippetsBridge.snippets.length + @tr(" snippets"); }
            }
            content := Rectangle { background: Theme.base; vertical-stretch: 1;
                if SnippetsBridge.snippets.length == 0: EmptyState {
                    icon: SnippetsBridge.query == "" ? @image-url("../icons/snippets.svg") : @image-url("../icons/search.svg");
                    title: SnippetsBridge.query == "" ? @tr("No snippets yet") : @tr("No matching snippets");
                    description: SnippetsBridge.query == "" ? @tr("Save commands you run often and paste them into any session.") : @tr("Try another name, command, or tag.");
                    action-text: @tr("New snippet");
                    action-visible: SnippetsBridge.query == "" && !SnippetsBridge.editing;
                    action-clicked => { SnippetsBridge.create(); }
                }
                if SnippetsBridge.snippets.length > 0: Rectangle {
                    x: Theme.gutter; y: Theme.gutter;
                    width: parent.width - 2 * Theme.gutter; height: parent.height - 2 * Theme.gutter;
                    background: Theme.highest; border-radius: Theme.r-field; clip: true;
                    ListView { for snippet in SnippetsBridge.snippets: SnippetItem { snippet: snippet; } }
                }
            }
        }
        if SnippetsBridge.editing: DetailPanel {
            title: SnippetsBridge.draft-id == "" ? @tr("New snippet") : @tr("Edit snippet");
            more-visible: SnippetsBridge.draft-id != "";
            primary-text: @tr("Save");
            close => { SnippetsBridge.cancel(); }
            more-clicked => { root.delete-menu-open = true; }
            primary-clicked => { SnippetsBridge.save(SnippetsBridge.draft-name, SnippetsBridge.draft-tags, SnippetsBridge.draft-script); }
            Card { title: @tr("Label");
                Field { label: @tr("Name"); placeholder: @tr("e.g. Deploy staging"); text <=> SnippetsBridge.draft-name; }
                Field { label: @tr("Tags"); placeholder: @tr("Comma separated"); text <=> SnippetsBridge.draft-tags; }
            }
            Card { title: @tr("Script");
                TextArea { height: 200px; mono: true; filled: false; placeholder: @tr("Enter one or more commands..."); text <=> SnippetsBridge.draft-script; }
            }
            if SnippetsBridge.error-text != "": Text {
                text: SnippetsBridge.error-text; color: Theme.danger;
                font-size: Theme.font-caption; wrap: word-wrap;
            }
        }
    }
    Popover {
        open <=> root.delete-menu-open;
        anchor-x: root.width - 200px - Theme.gutter;
        anchor-y: Theme.header-height;
        MenuItem {
            text: @tr("Delete snippet"); danger: true; has-icon: true;
            icon: @image-url("../icons/trash.svg");
            clicked => { root.delete-menu-open = false; SnippetsBridge.delete(SnippetsBridge.draft-id); }
        }
    }
}
