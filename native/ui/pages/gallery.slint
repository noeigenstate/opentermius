// Smoke-only showcase: --smoke-test --smoke-scene=section-gallery.
// Sheets keep samples readable at normal desktop sizes; Light/Dark applies to all samples.
import { ScrollView } from "std-widgets.slint";
import { Theme, Action, IconButton, Input, SearchField, TextArea, Field, Toggle, Checkbox, Segmented, Select, Popover, MenuItem, MenuSeparator, Card, EntityCard, ListRow, TableHeader, StatusDot, Badge, SectionHeader, Caption, PageHeader, PageToolbar, EmptyState, DetailPanel, SettingRow, Dialog, NavItem } from "../common.slint";

component Sample inherits Rectangle {
    in property <string> title;
    background: Theme.highest; border-radius: Theme.r-field;
    VerticalLayout { padding: 20px; spacing: 12px;
        SectionHeader { text: root.title; height: 20px; }
        @children
    }
}

export component GalleryPage inherits Rectangle {
    background: Theme.base;
    property <int> sheet: 0;
    property <bool> menu-open: false;
    property <bool> dialog-open: false;
    property <string> feedback: @tr("Hover, focus and click to inspect states");
    private property <length> sample-width: (scroller.visible-width - 56px) / 2;
    property <[string]> icon-names: ["check", "search", "trash", "copy", "play", "stop", "edit", "download", "menu", "chevron-right", "chevron-left", "info", "warning", "eye"];
    property <[image]> icons: [@image-url("../icons/check.svg"), @image-url("../icons/search.svg"), @image-url("../icons/trash.svg"), @image-url("../icons/copy.svg"), @image-url("../icons/play.svg"), @image-url("../icons/stop.svg"), @image-url("../icons/edit.svg"), @image-url("../icons/download.svg"), @image-url("../icons/menu.svg"), @image-url("../icons/chevron-right.svg"), @image-url("../icons/chevron-left.svg"), @image-url("../icons/info.svg"), @image-url("../icons/warning.svg"), @image-url("../icons/eye.svg")];

    VerticalLayout { spacing: 0px;
        Rectangle { height: 56px; background: Theme.high;
            HorizontalLayout { padding-left: Theme.gutter; padding-right: Theme.gutter; spacing: 12px; cross-axis-alignment: center;
                Text { text: @tr("Design foundation"); color: Theme.text; font-size: 18px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                Segmented { options: [@tr("Light"), @tr("Dark")]; current-index: Theme.dark ? 1 : 0; changed(index) => { Theme.dark = index == 1; } }
            }
        }
        PageToolbar {
            Segmented { options: [@tr("Controls"), @tr("Layouts"), @tr("Tokens & icons")]; segment-min-width: 96px; current-index <=> root.sheet; }
            Rectangle { horizontal-stretch: 1; }
            Caption { text: root.feedback; overflow: elide; }
        }
        scroller := ScrollView { vertical-stretch: 1;
            content-height: samples.preferred-height;
            samples := VerticalLayout { width: scroller.visible-width; spacing: 16px; padding: 20px;
                if root.sheet == 0: HorizontalLayout { spacing: 16px; cross-axis-alignment: start;
                    VerticalLayout { spacing: 16px; width: root.sample-width;
                        Sample { title: @tr("Actions · sizes & variants");
                            HorizontalLayout { spacing: 8px; cross-axis-alignment: center;
                                Action { kind: "primary"; size: "s"; text: @tr("Small"); }
                                Action { kind: "primary"; text: @tr("Medium"); }
                                Action { kind: "primary"; size: "l"; text: @tr("New host"); has-icon: true; icon: @image-url("../icons/plus.svg"); }
                            }
                            HorizontalLayout { spacing: 8px;
                                Action { kind: "secondary"; text: @tr("Secondary"); }
                                Action { kind: "flat"; text: @tr("Flat"); }
                                Action { kind: "primary"; disabled: true; text: @tr("Disabled"); }
                            }
                            HorizontalLayout { spacing: 8px; cross-axis-alignment: center;
                                Action { kind: "danger"; text: @tr("Delete"); }
                                Action { kind: "danger-flat"; text: @tr("Remove"); }
                                IconButton { icon: @image-url("../icons/copy.svg"); }
                                IconButton { icon: @image-url("../icons/trash.svg"); button-size: 24px; danger: true; }
                                IconButton { icon: @image-url("../icons/play.svg"); enabled: false; }
                            }
                            Caption { text: @tr("Legacy primary / flat / secondary APIs"); }
                            HorizontalLayout { spacing: 8px;
                                Action { primary: true; text: @tr("Connect"); }
                                Action { flat: true; secondary: true; text: @tr("Choose key"); }
                                Action { disabled: true; text: @tr("Disabled"); }
                            }
                        }
                        Sample { title: @tr("Selection & status");
                            HorizontalLayout { spacing: 16px; cross-axis-alignment: center;
                                Toggle { checked: true; } Toggle { } Toggle { enabled: false; }
                                Checkbox { text: @tr("Include keys"); checked: true; }
                            }
                            HorizontalLayout { spacing: 16px;
                                Checkbox { text: @tr("Replace data"); }
                                Checkbox { text: @tr("Disabled"); enabled: false; checked: true; }
                            }
                            Segmented { options: [@tr("Local"), @tr("Remote"), @tr("Dynamic")]; current-index: 1; }
                            Select { options: [@tr("Backspace"), @tr("Delete"), @tr("Escape"), @tr("Default"), @tr("Option 5"), @tr("Option 6"), @tr("Option 7"), @tr("Option 8")]; current-index: 0; }
                            HorizontalLayout { spacing: 8px; cross-axis-alignment: center;
                                StatusDot { kind: "ok"; } Caption { text: @tr("Connected"); }
                                StatusDot { kind: "warn"; } Caption { text: @tr("Warning"); }
                                StatusDot { kind: "error"; } Caption { text: @tr("Error"); }
                            }
                            HorizontalLayout { spacing: 8px; cross-axis-alignment: center;
                                StatusDot { } Caption { text: @tr("Idle"); }
                                StatusDot { kind: "busy"; } Caption { text: @tr("Working"); }
                            }
                            HorizontalLayout { spacing: 8px;
                                Badge { text: @tr("Key"); kind: "accent"; } Badge { text: @tr("OK"); kind: "success"; }
                                Badge { text: @tr("Warn"); kind: "warning"; } Badge { text: @tr("Error"); kind: "danger"; } Badge { text: @tr("Local"); }
                            }
                        }
                    }
                    VerticalLayout { spacing: 16px; width: root.sample-width;
                        Sample { title: @tr("Inputs · enabled / disabled / error");
                            SearchField { placeholder: @tr("Search keys"); }
                            HorizontalLayout { spacing: 8px;
                                Input { placeholder-text: @tr("IP or Hostname"); }
                                Input { compact: true; text: @tr("22"); width: 72px; }
                            }
                            Input { text: @tr("Disabled value"); enabled: false; }
                            Input { text: @tr("Passphrase"); input-type: InputType.password; filled: true; }
                            Field { label: @tr("Destination port"); text: @tr("70000"); invalid: true; helper: @tr("Port must be between 1 and 65535"); }
                            TextArea { mono: true; text: @tr("uptime && df -h\nkubectl get pods -A"); height: 120px; }
                        }
                        Sample { title: @tr("Menus & dialogs");
                            HorizontalLayout { spacing: 8px;
                                Action { text: @tr("Open menu"); clicked => { root.menu-open = true; } }
                                Action { text: @tr("Open dialog"); clicked => { root.dialog-open = true; } }
                            }
                            MenuItem { text: @tr("Copy fingerprint"); has-icon: true; icon: @image-url("../icons/copy.svg"); }
                            MenuItem { text: @tr("Selected option"); show-check: true; }
                            MenuSeparator { }
                            MenuItem { text: @tr("Remove key"); danger: true; has-icon: true; icon: @image-url("../icons/trash.svg"); }
                            MenuItem { text: @tr("Unavailable"); enabled: false; }
                        }
                    }
                }
                if root.sheet == 1: VerticalLayout { spacing: 16px;
                    Sample { title: @tr("Page bands");
                        PageHeader { placeholder: @tr("Search keys"); primary-text: @tr("New key"); primary-has-icon: true; primary-icon: @image-url("../icons/plus.svg"); }
                        PageToolbar { Action { text: @tr("Import key"); } Rectangle { horizontal-stretch: 1; } IconButton { icon: @image-url("../icons/more.svg"); } }
                    }
                    HorizontalLayout { spacing: 16px; cross-axis-alignment: start;
                        VerticalLayout { spacing: 16px; horizontal-stretch: 1;
                            EntityCard { title: @tr("Production web"); subtitle: "tester@10.0.0.4:22"; icon: @image-url("../icons/hosts.svg"); more-clicked => { root.feedback = @tr("More clicked"); } }
                            EntityCard { title: @tr("Staging"); subtitle: @tr("1 host"); selected: true; icon: @image-url("../icons/group.svg"); }
                            Card { title: @tr("Address"); Input { placeholder-text: @tr("IP or Hostname"); } }
                            Sample { title: @tr("List rows");
                                ListRow { title: "deploy.sh"; subtitle: "cd /srv/app && git pull"; selected: true;
                                    IconButton { icon: @image-url("../icons/copy.svg"); clicked => { root.feedback = @tr("Copy clicked"); } }
                                }
                                ListRow { title: @tr("Single line row"); StatusDot { kind: "ok"; } }
                            }
                            Rectangle { background: Theme.highest; border-radius: Theme.r-field;
                                VerticalLayout { spacing: 0px;
                                    SettingRow { label: @tr("Copy on select"); description: @tr("Copy selected terminal text"); Toggle { checked: true; } }
                                    SettingRow { label: @tr("Font size"); divider: false; Select { width: 120px; options: [@tr("12"), @tr("14"), @tr("16")]; current-index: 1; } }
                                }
                            }
                            TableHeader { labels: [@tr("Name"), @tr("Type"), @tr("Status")]; cols: [0.5, 0.25, 0.25]; }
                            NavItem { text: @tr("Hosts"); icon: @image-url("../icons/hosts.svg"); }
                            NavItem { text: @tr("Keychain"); icon: @image-url("../icons/keychain.svg"); active: true; }
                            NavItem { text: @tr("Logs"); icon: @image-url("../icons/history.svg"); enabled: false; }
                        }
                        DetailPanel { title: @tr("New key"); height: 560px;
                            Card { title: @tr("Label"); Field { label: @tr("Name"); placeholder: @tr("Production key"); } }
                            Card { title: @tr("Credentials"); Field { label: @tr("Username"); text: @tr("deploy"); } }
                        }
                    }
                    Rectangle { height: 300px; EmptyState { icon: @image-url("../icons/keychain.svg"); title: @tr("No keys yet"); description: @tr("Save credentials to reuse across hosts."); action-text: @tr("New key"); } }
                    Rectangle { height: 200px; EmptyState { icon: @image-url("../icons/search.svg"); title: @tr("No matching hosts"); description: @tr("Try another label or address."); action-visible: false; } }
                }
                if root.sheet == 2: VerticalLayout { spacing: 16px;
                    Sample { title: @tr("Palette & typography · follows Theme.dark");
                        HorizontalLayout { spacing: 12px;
                            Rectangle { height: 56px; background: Theme.base; border-width: 1px; border-color: Theme.border; Text { text: @tr("base"); color: Theme.text; horizontal-alignment: center; vertical-alignment: center; } }
                            Rectangle { background: Theme.high; Text { text: @tr("high"); color: Theme.text; horizontal-alignment: center; vertical-alignment: center; } }
                            Rectangle { background: Theme.lowest; Text { text: @tr("lowest"); color: Theme.on-accent; horizontal-alignment: center; vertical-alignment: center; } }
                            Rectangle { background: Theme.accent; Text { text: @tr("accent"); color: Theme.on-accent; horizontal-alignment: center; vertical-alignment: center; } }
                            Rectangle { background: Theme.danger; Text { text: @tr("danger"); color: Theme.on-accent; horizontal-alignment: center; vertical-alignment: center; } }
                        }
                        Text { text: @tr("Page title 18 / 600"); font-size: Theme.font-title; font-weight: 600; color: Theme.text; }
                        SectionHeader { text: @tr("Section header 14 / 600"); }
                        Text { text: @tr("Body 14 / 400 · All controls support Chinese"); font-size: Theme.font-body; color: Theme.text; }
                        Caption { text: @tr("Caption 12 / 400"); }
                        Text { text: "SHA256:8f2adc0b19e7c4a1b6d3f9e2085c7a4b"; font-family: Theme.mono-font; font-size: Theme.font-mono; color: Theme.text; }
                    }
                    Sample { title: @tr("Project-authored icons · 24 × 24 / stroke 1.8");
                        for glyph[index] in root.icons: HorizontalLayout { spacing: 16px; cross-axis-alignment: center;
                            Image { source: glyph; colorize: Theme.text; width: 24px; height: 24px; }
                            Caption { text: root.icon-names[index]; }
                        }
                    }
                }
            }
        }
    }
    // Last children: full-page overlay layers for click-away and modal input capture.
    Popover { open <=> root.menu-open; anchor-x: 24px; anchor-y: 140px;
        MenuItem { text: @tr("Copy fingerprint"); has-icon: true; icon: @image-url("../icons/copy.svg"); clicked => { root.menu-open = false; root.feedback = @tr("Copied"); } }
        MenuItem { text: @tr("Edit key"); has-icon: true; icon: @image-url("../icons/edit.svg"); }
        MenuSeparator { }
        MenuItem { text: @tr("Remove key"); danger: true; has-icon: true; icon: @image-url("../icons/trash.svg"); }
    }
    Dialog { open <=> root.dialog-open; title: @tr("Backup & Restore"); dialog-width: 560px;
        description: @tr("Back up hosts, keys and settings to an encrypted file."); confirm-text: @tr("Back up");
        confirm => { root.dialog-open = false; root.feedback = @tr("Confirmed"); }
        cancel => { root.feedback = @tr("Cancelled"); }
        Field { label: @tr("Password"); secret: true; placeholder: @tr("Password"); }
        Checkbox { text: @tr("Include saved passwords"); checked: true; }
    }
}
