import { Theme, Action, PageHeader, PageToolbar, EmptyState, TableHeader, StatusDot, Caption, Dialog } from "../common.slint";
import { ListView } from "std-widgets.slint";

export struct LogRow {
    id: string,
    host-id: string,
    label: string,
    address: string,
    started: string,
    duration: string,
    status: string,
    error: string,
    can-connect: bool,
}

// Rust reads and drives this page through the global bridge.
export global LogsBridge {
    in-out property <[LogRow]> rows;
    in-out property <string> query;
    in property <int> total: 0;
    in property <string> storage-error;
    callback refresh();
    callback clear();
    callback connect-again(string);
}

// Connection history keeps its existing metadata and reconnect action. The bridge
// has no diagnostic levels/export API, so no inert severity controls are presented.
component LogTableRow inherits Rectangle {
    in property <LogRow> entry;
    in property <[float]> cols;
    in property <[float]> offsets;
    private property <length> table-width: root.width - root.action-width;
    in property <length> action-width;
    height: Theme.row-height;
    background: row-touch.has-hover || reconnect.hovered ? Theme.hover : transparent;
    animate background { duration: 100ms; }
    row-touch := TouchArea { }
    Rectangle { x: root.table-width * root.offsets[0]; y: 0px; width: root.table-width * root.cols[0]; height: parent.height;
        VerticalLayout { padding-left: Theme.space-16; padding-right: Theme.space-8; alignment: center; spacing: Theme.space-4;
            Text { text: root.entry.label; color: Theme.text; font-size: Theme.font-body; font-weight: 500; overflow: elide; }
            Text { text: root.entry.address; color: Theme.secondary; font-family: Theme.mono-font; font-size: Theme.font-caption; overflow: elide; }
        }
    }
    Rectangle { x: root.table-width * root.offsets[1]; y: 0px; width: root.table-width * root.cols[1]; height: parent.height;
        Text { x: Theme.space-16; width: parent.width - Theme.space-24; height: parent.height; text: root.entry.started; color: Theme.secondary; font-family: Theme.mono-font; font-size: Theme.font-caption; vertical-alignment: center; overflow: elide; }
    }
    Rectangle { x: root.table-width * root.offsets[2]; y: 0px; width: root.table-width * root.cols[2]; height: parent.height;
        Text { x: Theme.space-16; width: parent.width - Theme.space-24; height: parent.height; text: root.entry.duration; color: Theme.secondary; font-size: Theme.font-caption; vertical-alignment: center; overflow: elide; }
    }
    Rectangle { x: root.table-width * root.offsets[3]; y: 0px; width: root.table-width * root.cols[3]; height: parent.height;
        HorizontalLayout { padding-left: Theme.space-16; padding-right: Theme.space-8; spacing: Theme.space-8; cross-axis-alignment: center;
            StatusDot { kind: root.entry.status == "Connected" ? "ok" : root.entry.status == "Failed" ? "error" : root.entry.status == "Connecting" ? "busy" : "idle"; }
            Text { text: root.entry.status; color: Theme.text; font-size: Theme.font-caption; vertical-alignment: center; overflow: elide; }
        }
    }
    Rectangle { x: root.table-width * root.offsets[4]; y: 0px; width: root.table-width * root.cols[4]; height: parent.height;
        Text { x: Theme.space-16; width: parent.width - Theme.space-24; height: parent.height; text: root.entry.error; color: Theme.danger; font-size: Theme.font-caption; vertical-alignment: center; overflow: elide; }
    }
    reconnect := Action {
        x: parent.width - root.action-width + Theme.space-4; y: (parent.height - self.height) / 2;
        width: root.action-width - Theme.space-12;
        kind: "flat"; size: "s"; text: "Connect again"; visible: root.entry.can-connect;
        clicked => { LogsBridge.connect-again(root.entry.host-id); }
    }
    Rectangle { x: Theme.space-12; y: parent.height - 1px; width: parent.width - Theme.space-24; height: 1px; background: Theme.divider; }
}

export component LogsPage inherits Rectangle {
    background: Theme.base;
    property <bool> confirm-clear: false;
    property <[float]> offsets: [0, root.cols[0], root.cols[0] + root.cols[1], root.cols[0] + root.cols[1] + root.cols[2], root.cols[0] + root.cols[1] + root.cols[2] + root.cols[3]];
    property <[float]> cols: [0.24, 0.25, 0.14, 0.19, 0.18];
    // A fixed trailing slot keeps reconnect actions aligned with the table header.
    property <length> action-width: 120px;
    VerticalLayout { spacing: 0px;
        PageHeader {
            placeholder: "Filter logs"; search <=> LogsBridge.query; show-primary: false;
            search-changed => { LogsBridge.refresh(); }
            search-accepted => { LogsBridge.refresh(); }
        }
        PageToolbar {
            Caption { text: LogsBridge.query == "" ? (LogsBridge.total == 1 ? "1 session" : LogsBridge.total + " sessions") : LogsBridge.rows.length + " of " + LogsBridge.total + " shown"; }
            Rectangle { horizontal-stretch: 1; }
            Action { kind: "danger-flat"; text: "Clear logs"; has-icon: true; icon: @image-url("../icons/trash.svg"); disabled: LogsBridge.total == 0; clicked => { root.confirm-clear = true; } }
        }
        if LogsBridge.storage-error != "": Rectangle {
            height: Theme.input-height; background: Theme.danger-soft;
            Text { x: Theme.gutter; width: parent.width - 2 * Theme.gutter; height: parent.height; text: LogsBridge.storage-error; color: Theme.danger; font-size: Theme.font-caption; vertical-alignment: center; overflow: elide; }
        }
        Rectangle { vertical-stretch: 1; background: Theme.base;
            if LogsBridge.rows.length == 0: EmptyState {
                icon: LogsBridge.query == "" ? @image-url("../icons/history.svg") : @image-url("../icons/search.svg");
                title: LogsBridge.total == 0 ? "No log entries" : "No matching sessions";
                description: LogsBridge.total == 0 ? "Connect to a host or open a terminal to see it here." : "Try a different host, address or status.";
                action-visible: false;
            }
            if LogsBridge.rows.length > 0: Rectangle {
                x: Theme.gutter; y: Theme.gutter;
                width: parent.width - 2 * Theme.gutter; height: parent.height - 2 * Theme.gutter;
                background: Theme.highest; border-radius: Theme.r-field; clip: true;
                VerticalLayout { spacing: 0px;
                    Rectangle { width: parent.width; height: Theme.table-header-height; background: Theme.high;
                        heading := Rectangle { x: 0px; y: 0px; width: parent.width - root.action-width; height: parent.height;
                            // Explicit cells keep intrinsic label widths from shifting columns.
                            for label[index] in ["Host / address", "Started", "Duration", "Status", "Details"]: TableHeader {
                                x: heading.width * root.offsets[index]; y: 0px;
                                width: heading.width * root.cols[index]; height: Theme.table-header-height;
                                labels: [label]; cols: [1];
                            }
                        }
                    }
                    ListView { vertical-stretch: 1;
                        for entry in LogsBridge.rows: LogTableRow { entry: entry; cols: root.cols; offsets: root.offsets; action-width: root.action-width; }
                    }
                }
            }
        }
        Rectangle { height: Theme.input-height; background: Theme.high;
            Rectangle { x: 0px; y: 0px; height: 1px; width: parent.width; background: Theme.divider; }
            Caption { x: Theme.gutter; width: parent.width - 2 * Theme.gutter; height: parent.height; text: "History is stored locally. Credentials and terminal output are never recorded."; overflow: elide; }
        }
    }
    Timer { interval: 1000ms; running: true; triggered => { LogsBridge.refresh(); } }
    init => { LogsBridge.refresh(); }
    Dialog {
        open <=> root.confirm-clear; title: "Clear connection history?";
        description: "This removes every connection log stored on this computer. It cannot be undone.";
        confirm-text: "Clear logs"; confirm-kind: "danger";
        confirm => { root.confirm-clear = false; LogsBridge.clear(); }
    }
}
