import { ScrollView } from "std-widgets.slint";
import { Theme, Action, Toggle, Segmented, Select, SettingRow, Caption } from "../common.slint";
import { RecoveryBridge } from "recovery.slint";

// Rust reads and drives this page through the global bridge.
export global SettingsBridge {
    // Terminal
    in-out property <int> terminal-font-size: 14;
    in-out property <int> scrollback-lines: 3000;
    in-out property <bool> cursor-blink: true;
    in-out property <bool> copy-on-select: false;
    in-out property <bool> confirm-multiline-paste: true;
    in-out property <int> bell-mode: 1;
    // Appearance
    in-out property <int> color-scheme: 0;
    in-out property <int> appearance: 0;
    in-out property <int> language: 2;
    in-out property <bool> gpu-rendering: false;
    // SSH
    in-out property <int> keepalive-seconds: 30;
    in-out property <int> connection-timeout-seconds: 15;
    // SFTP
    in-out property <bool> confirm-overwrite: true;
    in-out property <bool> show-hidden-files: true;
    // About
    in-out property <string> version: "";
    in-out property <string> config-path: "";

    callback apply;
    callback restore-defaults;
    callback open-config-folder;
}

// Card has fixed inner padding; grouped settings need edge-to-edge SettingRows.
component SettingsGroup inherits VerticalLayout {
    in property <string> title;
    spacing: Theme.space-8;
    Text {
        text: root.title; color: Theme.secondary; font-size: Theme.font-mono;
        font-weight: 600; height: Theme.space-20; vertical-alignment: center;
    }
    Rectangle {
        background: Theme.highest; border-radius: Theme.r-field;
        VerticalLayout { spacing: 0px; @children }
    }
}

// Numeric preferences keep their existing ranges and apply immediately.
component Stepper inherits Rectangle {
    in property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 1;
    in property <string> suffix: "";
    callback value-changed(int);
    width: 200px; height: Theme.input-height;
    border-radius: Theme.r-field; border-width: 1px; border-color: Theme.border;
    background: transparent;
    HorizontalLayout {
        padding: Theme.space-2; spacing: 0px; cross-axis-alignment: center;
        Action {
            kind: "flat"; text: @tr("−"); width: Theme.button-m;
            disabled: root.value <= root.minimum;
            clicked => { root.value-changed(Math.max(root.minimum, root.value - root.step)); }
        }
        Text {
            text: root.value + root.suffix; color: Theme.text; font-size: Theme.font-body;
            horizontal-alignment: center; vertical-alignment: center; horizontal-stretch: 1;
        }
        Action {
            kind: "flat"; text: @tr("+"); width: Theme.button-m;
            disabled: root.value >= root.maximum;
            clicked => { root.value-changed(Math.min(root.maximum, root.value + root.step)); }
        }
    }
}

export component SettingsPage inherits Rectangle {
    background: Theme.base;
    scroller := ScrollView {
        content-height: column.preferred-height;
        column := VerticalLayout {
            width: Math.min(720px, scroller.visible-width - Theme.gutter * 2);
            x: Theme.gutter;
            padding-top: Theme.space-24; padding-bottom: Theme.space-32;
            spacing: Theme.space-24;
            Text {
                text: @tr("Settings"); color: Theme.text; font-size: Theme.font-title;
                font-weight: 600; height: 28px; vertical-alignment: center;
            }

            SettingsGroup {
                title: @tr("Appearance");
                SettingRow {
                    label: @tr("Language");
                    Select {
                        width: 200px; options: [@tr("English"), @tr("简体中文"), @tr("System")];
                        current-index <=> SettingsBridge.language;
                        changed(index) => { SettingsBridge.apply(); }
                    }
                }
                SettingRow {
                    label: @tr("Theme");
                    Segmented {
                        options: [@tr("Light"), @tr("Dark"), @tr("System")]; current-index <=> SettingsBridge.appearance;
                        changed(index) => { SettingsBridge.apply(); }
                    }
                }
                SettingRow {
                    label: @tr("Smoother rendering (GPU)"); description: @tr("Uses more memory. Takes effect after restart.");
                    Toggle { checked <=> SettingsBridge.gpu-rendering; toggled => { SettingsBridge.apply(); } }
                }
                SettingRow {
                    label: @tr("Terminal color scheme"); description: @tr("Applied to every terminal session"); divider: false;
                    Select {
                        width: 200px; options: [@tr("Default"), @tr("Solarized Dark"), @tr("Monokai"), @tr("Light")];
                        current-index <=> SettingsBridge.color-scheme;
                        changed(index) => { SettingsBridge.apply(); }
                    }
                }
            }

            SettingsGroup {
                title: @tr("Terminal");
                SettingRow {
                    label: @tr("Font size"); description: @tr("Terminal font ({}), 10–24 px", Theme.mono-font);
                    Select {
                        width: 200px;
                        options: [@tr("10 px"), @tr("11 px"), @tr("12 px"), @tr("13 px"), @tr("14 px"), @tr("15 px"), @tr("16 px"), @tr("17 px"), @tr("18 px"), @tr("19 px"), @tr("20 px"), @tr("21 px"), @tr("22 px"), @tr("23 px"), @tr("24 px")];
                        current-index: SettingsBridge.terminal-font-size - 10;
                        changed(index) => { SettingsBridge.terminal-font-size = index + 10; SettingsBridge.apply(); }
                    }
                }
                SettingRow {
                    label: @tr("Scrollback"); description: @tr("History lines for new terminal sessions");
                    Stepper {
                        value: SettingsBridge.scrollback-lines; minimum: 1000; maximum: 100000; step: 1000; suffix: @tr(" lines");
                        value-changed(value) => { SettingsBridge.scrollback-lines = value; SettingsBridge.apply(); }
                    }
                }
                SettingRow {
                    label: @tr("Cursor blink");
                    Toggle { checked <=> SettingsBridge.cursor-blink; toggled => { SettingsBridge.apply(); } }
                }
                SettingRow {
                    label: @tr("Copy on select");
                    Toggle { checked <=> SettingsBridge.copy-on-select; toggled => { SettingsBridge.apply(); } }
                }
                SettingRow {
                    label: @tr("Confirm multi-line paste");
                    Toggle { checked <=> SettingsBridge.confirm-multiline-paste; toggled => { SettingsBridge.apply(); } }
                }
                SettingRow {
                    label: @tr("Bell"); description: @tr("Audible bell is not used"); divider: false;
                    Segmented {
                        options: [@tr("None"), @tr("Visual")]; current-index <=> SettingsBridge.bell-mode;
                        changed(index) => { SettingsBridge.apply(); }
                    }
                }
            }

            SettingsGroup {
                title: @tr("SSH");
                SettingRow {
                    label: @tr("Keepalive interval"); description: @tr("New sessions; 0 disables keepalive");
                    Stepper {
                        value: SettingsBridge.keepalive-seconds; minimum: 0; maximum: 3600; step: 5; suffix: @tr(" s");
                        value-changed(value) => { SettingsBridge.keepalive-seconds = value; SettingsBridge.apply(); }
                    }
                }
                SettingRow {
                    label: @tr("Connection timeout"); description: @tr("Handshake timeout for new sessions"); divider: false;
                    Stepper {
                        value: SettingsBridge.connection-timeout-seconds; minimum: 1; maximum: 300; suffix: @tr(" s");
                        value-changed(value) => { SettingsBridge.connection-timeout-seconds = value; SettingsBridge.apply(); }
                    }
                }
            }

            SettingsGroup {
                title: @tr("SFTP");
                SettingRow {
                    label: @tr("Confirm overwrite on upload"); description: @tr("Ask before replacing a remote file");
                    Toggle { checked <=> SettingsBridge.confirm-overwrite; toggled => { SettingsBridge.apply(); } }
                }
                SettingRow {
                    label: @tr("Show hidden files"); description: @tr("Include dotfiles and Windows hidden files"); divider: false;
                    Toggle { checked <=> SettingsBridge.show-hidden-files; toggled => { SettingsBridge.apply(); } }
                }
            }

            SettingsGroup {
                title: @tr("Data");
                SettingRow {
                    label: @tr("Backup & Restore"); description: @tr("Move your configuration between machines, offline"); divider: false;
                    Action { kind: "secondary"; text: @tr("Open…"); clicked => { RecoveryBridge.visible = true; } }
                }
            }

            SettingsGroup {
                title: @tr("About");
                SettingRow {
                    label: @tr("OpenTermius"); description: @tr("Version ") + SettingsBridge.version;
                    Action { kind: "flat"; text: @tr("Restore defaults"); clicked => { SettingsBridge.restore-defaults(); } }
                }
                Rectangle {
                    height: 64px;
                    HorizontalLayout {
                        padding-left: Theme.gutter; padding-right: Theme.gutter; spacing: Theme.space-12;
                        cross-axis-alignment: center;
                        VerticalLayout {
                            spacing: Theme.space-4; horizontal-stretch: 1;
                            Text { text: @tr("Config folder"); color: Theme.text; font-size: Theme.font-body; font-weight: 500; }
                            Text {
                                text: SettingsBridge.config-path; color: Theme.secondary; font-family: "Consolas";
                                font-size: Theme.font-caption; overflow: elide;
                            }
                        }
                        Action { kind: "secondary"; size: "s"; text: @tr("Open"); clicked => { SettingsBridge.open-config-folder(); } }
                    }
                    Rectangle { x: Theme.gutter; y: parent.height - 1px; width: parent.width - Theme.gutter * 2; height: 1px; background: Theme.divider; }
                }
                VerticalLayout {
                    padding: Theme.gutter; spacing: Theme.space-12;
                    Text { text: @tr("Privacy"); color: Theme.text; font-size: Theme.font-body; font-weight: 600; }
                    Caption { text: @tr("Credentials are encrypted with Windows DPAPI. No account, cloud sync or telemetry. Host JSON exports exclude saved credentials."); wrap: word-wrap; }
                    Text { text: @tr("License"); color: Theme.text; font-size: Theme.font-body; font-weight: 600; }
                    Caption { text: @tr("OpenTermius ") + SettingsBridge.version + @tr(" — UNLICENSED. Third-party components remain under their respective licenses (Rust, Slint, russh, vt100, and others)."); wrap: word-wrap; }
                }
            }
        }
    }
}
