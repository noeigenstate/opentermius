import { Theme, Action, IconButton, PageHeader, PageToolbar, EmptyState, TableHeader, Caption, Dialog } from "../common.slint";
import { ListView } from "std-widgets.slint";

// One trusted fingerprint; `usage` lists the saved hosts that connect with it.
export struct KnownHostRow {
    host: string,
    port: int,
    fingerprint: string,
    usage: string,
}

// Rust reads and drives this page through the global bridge.
export global KnownHostsBridge {
    in-out property <string> search;
    in property <[KnownHostRow]> entries;
    in property <int> total;
    in property <string> status;
    in property <bool> status-error;
    callback refresh;
    callback page-shown;
    callback import-known-hosts;
    callback remove-host(string, int);
}

// The current bridge supplies port and saved-host usage, rather than key type/date.
component KnownHostItem inherits Rectangle {
    in property <KnownHostRow> entry;
    in property <[float]> cols;
    in property <[float]> offsets;
    private property <length> table-width: root.width - Theme.table-row-height;
    callback remove;
    height: Theme.table-row-height;
    background: row-touch.has-hover || remove-button.hovered ? Theme.hover : transparent;
    animate background { duration: 100ms; }
    row-touch := TouchArea { }
    Rectangle { x: root.table-width * root.offsets[0]; y: 0px; width: root.table-width * root.cols[0]; height: parent.height;
        Text { x: Theme.space-16; width: parent.width - Theme.space-24; height: parent.height; text: root.entry.host; color: Theme.text; font-size: Theme.font-body; font-weight: 500; vertical-alignment: center; overflow: elide; }
    }
    Rectangle { x: root.table-width * root.offsets[1]; y: 0px; width: root.table-width * root.cols[1]; height: parent.height;
        Text { x: Theme.space-16; width: parent.width - Theme.space-24; height: parent.height; text: "\{root.entry.port}"; color: Theme.secondary; font-size: Theme.font-caption; vertical-alignment: center; overflow: elide; }
    }
    Rectangle { x: root.table-width * root.offsets[2]; y: 0px; width: root.table-width * root.cols[2]; height: parent.height;
        Text { x: Theme.space-16; width: parent.width - Theme.space-24; height: parent.height; text: root.entry.fingerprint; color: Theme.secondary; font-family: Theme.mono-font; font-size: Theme.font-caption; vertical-alignment: center; overflow: elide; }
    }
    Rectangle { x: root.table-width * root.offsets[3]; y: 0px; width: root.table-width * root.cols[3]; height: parent.height;
        Text { x: Theme.space-16; width: parent.width - Theme.space-24; height: parent.height; text: root.entry.usage; color: Theme.secondary; font-size: Theme.font-caption; vertical-alignment: center; overflow: elide; }
    }
    remove-button := IconButton {
        x: parent.width - Theme.space-32; y: Theme.space-8;
        button-size: Theme.button-s; icon: @image-url("../icons/trash.svg"); danger: true;
        visible: row-touch.has-hover || self.hovered;
        accessible-role: button;
        accessible-label: @tr("Remove trusted host");
        clicked => { root.remove(); }
    }
    Rectangle { x: Theme.space-12; y: parent.height - 1px; width: parent.width - Theme.space-24; height: 1px; background: Theme.divider; }
}

export component KnownHostsPage inherits Rectangle {
    background: Theme.base;
    property <bool> confirm-visible: false;
    property <string> pending-host;
    property <int> pending-port;
    property <string> pending-fingerprint;
    property <[float]> offsets: [0, root.cols[0], root.cols[0] + root.cols[1], root.cols[0] + root.cols[1] + root.cols[2]];
    property <[float]> cols: [0.24, 0.10, 0.42, 0.24];
    init => { KnownHostsBridge.page-shown(); }
    VerticalLayout { spacing: 0px;
        PageHeader {
            placeholder: @tr("Search known hosts"); search <=> KnownHostsBridge.search; show-primary: false;
            search-changed => { KnownHostsBridge.refresh(); }
            search-accepted => { KnownHostsBridge.refresh(); }
        }
        PageToolbar {
            Action { kind: "secondary"; text: @tr("Import"); has-icon: true; icon: @image-url("../icons/download.svg"); clicked => { KnownHostsBridge.import-known-hosts(); } }
            Action { kind: "flat"; text: @tr("Refresh"); clicked => { KnownHostsBridge.refresh(); } }
            Rectangle { horizontal-stretch: 1; }
            Caption { text: KnownHostsBridge.search == "" ? (KnownHostsBridge.total == 1 ? @tr("1 trusted host") : KnownHostsBridge.total + @tr(" trusted hosts")) : KnownHostsBridge.entries.length + @tr(" of ") + KnownHostsBridge.total + @tr(" shown"); overflow: elide; }
        }
        Rectangle { vertical-stretch: 1; background: Theme.base;
            if KnownHostsBridge.entries.length == 0: EmptyState {
                icon: KnownHostsBridge.search == "" ? @image-url("../icons/known.svg") : @image-url("../icons/search.svg");
                title: KnownHostsBridge.total == 0 ? @tr("No known hosts") : @tr("No matching hosts");
                description: KnownHostsBridge.total == 0 ? @tr("Hosts you trust on first connect appear here.") : @tr("Try another host name or fingerprint.");
                action-visible: false;
            }
            if KnownHostsBridge.entries.length > 0: Rectangle {
                x: Theme.gutter; y: Theme.gutter;
                width: parent.width - 2 * Theme.gutter; height: parent.height - 2 * Theme.gutter;
                background: Theme.highest; border-radius: Theme.r-field; clip: true;
                VerticalLayout { spacing: 0px;
                    Rectangle { height: Theme.table-header-height; background: Theme.high;
                        heading := Rectangle { x: 0px; y: 0px; width: parent.width - Theme.table-row-height; height: parent.height;
                            // Explicit cells keep intrinsic label widths from shifting columns.
                            for label[index] in [@tr("Host"), @tr("Port"), @tr("SHA-256 fingerprint"), @tr("Saved hosts")]: TableHeader {
                                x: heading.width * root.offsets[index]; y: 0px;
                                width: heading.width * root.cols[index]; height: Theme.table-header-height;
                                labels: [label]; cols: [1];
                            }
                        }
                    }
                    ListView { vertical-stretch: 1;
                        for entry in KnownHostsBridge.entries: KnownHostItem {
                            entry: entry; cols: root.cols; offsets: root.offsets;
                            remove => { root.pending-host = entry.host; root.pending-port = entry.port; root.pending-fingerprint = entry.fingerprint; root.confirm-visible = true; }
                        }
                    }
                }
            }
        }
        if KnownHostsBridge.status != "": Rectangle {
            height: Theme.input-height; background: KnownHostsBridge.status-error ? Theme.danger-soft : Theme.high;
            Text { x: Theme.gutter; width: parent.width - 2 * Theme.gutter; height: parent.height; text: KnownHostsBridge.status; color: KnownHostsBridge.status-error ? Theme.danger : Theme.secondary; font-size: Theme.font-caption; vertical-alignment: center; overflow: elide; }
        }
    }
    Dialog {
        open <=> root.confirm-visible;
        title: @tr("Remove trusted host?");
        description: @tr("OpenTermius will ask you to confirm the fingerprint again the next time it connects to this host.");
        confirm-text: @tr("Remove"); confirm-kind: "danger";
        confirm => { root.confirm-visible = false; KnownHostsBridge.remove-host(root.pending-host, root.pending-port); }
        Text { text: "\{root.pending-host}:\{root.pending-port}"; color: Theme.text; font-size: Theme.font-body; font-weight: 500; wrap: word-wrap; }
        Text { text: root.pending-fingerprint; color: Theme.secondary; font-family: Theme.mono-font; font-size: Theme.font-mono; wrap: char-wrap; }
    }
}
