import { ScrollView } from "std-widgets.slint";
import { Theme, Input, Field, PageHeader, PageToolbar, EmptyState, Card, DetailPanel, Select, Segmented, Checkbox, Badge, StatusDot, IconButton, Caption } from "../common.slint";

export struct ForwardRow { id: string, label: string, route: string, status: string, busy: bool, error: bool, connections: int }
export struct ForwardDraft { id: string, label: string, kind-index: int, host-index: int, bind-address: string, bind-port: string, destination-host: string, destination-port: string, auto-start: bool }
export global ForwardingBridge {
    in-out property <[ForwardRow]> rules;
    in-out property <[string]> hosts;
    in-out property <ForwardDraft> draft;
    in-out property <bool> editor-open: false;
    in-out property <string> message;
    callback new-rule;
    callback edit-rule(string);
    callback delete-rule(string);
    callback toggle-rule(string);
    callback save-rule;
}

export component ForwardingPage inherits Rectangle {
    background: Theme.base;
    property <string> search;
    property <int> kind-filter: 0;
    // ForwardRow exposes a formatted route; keep its complete mapping and host.
    pure function rule-kind(rule: ForwardRow) -> string {
        rule.route.starts-with(@tr("Local")) ? @tr("Local") : rule.route.starts-with(@tr("Remote")) ? @tr("Remote") : @tr("Dynamic")
    }
    pure function matches(rule: ForwardRow) -> bool {
        (kind-filter == 0 || root.rule-kind(rule) == [@tr("All"), @tr("Local"), @tr("Remote"), @tr("Dynamic")][kind-filter])
        && (search == "" || (rule.label + " " + rule.route + " " + rule.status).to-lowercase().replace-all(search.to-lowercase(), "") != (rule.label + " " + rule.route + " " + rule.status).to-lowercase())
    }
    HorizontalLayout { spacing: 0px;
        VerticalLayout { spacing: 0px; horizontal-stretch: 1; min-width: 0px;
            PageHeader {
                search <=> root.search; placeholder: @tr("Search forwarding rules");
                primary-text: @tr("New rule"); primary-has-icon: true; primary-icon: @image-url("../icons/plus.svg");
                primary-clicked => { ForwardingBridge.new-rule(); }
            }
            PageToolbar {
                Segmented { options: [@tr("All"), @tr("Local"), @tr("Remote"), @tr("Dynamic")]; segment-min-width: 64px; current-index <=> root.kind-filter; }
                Rectangle { horizontal-stretch: 1; }
            }
            // Save errors remain visible even when the editor body is scrolled.
            if ForwardingBridge.message != "": Rectangle {
                height: Theme.space-32;
                Text { x: Theme.gutter; width: parent.width - 2 * Theme.gutter; height: parent.height; text: ForwardingBridge.message; color: Theme.danger; font-size: Theme.font-caption; overflow: elide; vertical-alignment: center; }
            }
            if ForwardingBridge.rules.length == 0: EmptyState {
                vertical-stretch: 1; icon: @image-url("../icons/forward.svg"); title: @tr("No forwarding rules");
                description: @tr("Create local, remote or SOCKS5 tunnels through your saved SSH hosts.");
                action-text: @tr("New rule"); action-clicked => { ForwardingBridge.new-rule(); }
            }
            if ForwardingBridge.rules.length > 0: Rectangle {
                vertical-stretch: 1; min-height: 0px;
                table := Rectangle {
                    x: Theme.gutter; y: Theme.gutter; width: parent.width - 2 * Theme.gutter; height: parent.height - 2 * Theme.gutter;
                    background: Theme.highest; border-radius: Theme.r-field; clip: true;
                    private property <bool> wide: self.width >= 560px;
                    private property <length> name-width: self.wide ? self.width * 0.24 : self.width - 112px;
                    private property <length> type-width: self.wide ? 80px : 0px;
                    private property <length> action-width: 112px;
                    VerticalLayout { spacing: 0px;
                        Rectangle { height: Theme.table-header-height; background: Theme.high;
                            HorizontalLayout { spacing: 0px;
                                Rectangle { width: table.name-width;
                                    Text { x: Theme.space-16; width: parent.width - Theme.space-24; height: parent.height; text: @tr("Name"); color: Theme.secondary; font-size: Theme.font-caption; font-weight: 500; vertical-alignment: center; }
                                }
                                if table.wide: Text { width: table.type-width; text: @tr("Type"); color: Theme.secondary; font-size: Theme.font-caption; font-weight: 500; vertical-alignment: center; }
                                if table.wide: Text { horizontal-stretch: 1; text: @tr("Mapping / Via host"); color: Theme.secondary; font-size: Theme.font-caption; font-weight: 500; vertical-alignment: center; }
                                Text { width: table.action-width; text: @tr("Status / Actions"); color: Theme.secondary; font-size: Theme.font-caption; font-weight: 500; vertical-alignment: center; }
                            }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            rows := ScrollView {
                                content-height: row-list.preferred-height;
                                row-list := VerticalLayout {
                                    width: rows.visible-width; spacing: 0px; alignment: start;
                                    for rule in ForwardingBridge.rules: VerticalLayout {
                                        spacing: 0px;
                                        if root.matches(rule): Rectangle {
                                            height: table.wide ? 64px : 96px;
                                            background: row-touch.has-hover ? Theme.hover : transparent;
                                            row-touch := TouchArea { enabled: !rule.busy; mouse-cursor: pointer; clicked => { ForwardingBridge.edit-rule(rule.id); } }
                                            HorizontalLayout { spacing: 0px;
                                                Rectangle { width: table.name-width;
                                                    VerticalLayout { padding-left: Theme.space-16; padding-right: Theme.space-12; alignment: center; spacing: Theme.space-4;
                                                        Text { text: rule.label; color: Theme.text; font-size: Theme.font-body; font-weight: 500; overflow: elide; }
                                                        if !table.wide: Text { text: rule.route; color: Theme.secondary; font-size: Theme.font-mono; font-family: Theme.mono-font; overflow: elide; }
                                                        Caption { text: rule.status + " / " + rule.connections + @tr(" connections"); color: rule.error ? Theme.danger : Theme.secondary; overflow: elide; }
                                                    }
                                                }
                                                if table.wide: Rectangle { width: table.type-width;
                                                    Badge { x: 0px; y: (parent.height - self.height) / 2; text: root.rule-kind(rule); kind: "accent"; }
                                                }
                                                if table.wide: Rectangle { horizontal-stretch: 1;
                                                    Text { x: 0px; width: parent.width - Theme.space-12; height: parent.height; text: rule.route; color: Theme.text; font-size: Theme.font-mono; font-family: Theme.mono-font; vertical-alignment: center; overflow: elide; }
                                                }
                                                Rectangle { width: table.action-width;
                                                    VerticalLayout { alignment: center; spacing: Theme.space-8; padding-right: Theme.space-12;
                                                        HorizontalLayout { spacing: Theme.space-4; cross-axis-alignment: center;
                                                            StatusDot { kind: rule.error ? "error" : rule.busy ? "ok" : "idle"; }
                                                            Caption { text: rule.error ? @tr("Error") : rule.busy ? @tr("Active") : @tr("Stopped"); color: rule.error ? Theme.danger : Theme.secondary; }
                                                        }
                                                        HorizontalLayout { spacing: Theme.space-4;
                                                            IconButton { size: Theme.button-s; icon: rule.busy ? @image-url("../icons/stop.svg") : @image-url("../icons/play.svg"); clicked => { ForwardingBridge.toggle-rule(rule.id); } }
                                                            IconButton { size: Theme.button-s; icon: @image-url("../icons/edit.svg"); enabled: !rule.busy; clicked => { ForwardingBridge.edit-rule(rule.id); } }
                                                            IconButton { size: Theme.button-s; icon: @image-url("../icons/trash.svg"); danger: true; enabled: !rule.busy; clicked => { ForwardingBridge.delete-rule(rule.id); } }
                                                        }
                                                    }
                                                }
                                            }
                                            Rectangle { x: Theme.space-16; y: parent.height - 1px; width: parent.width - Theme.space-32; height: 1px; background: Theme.divider; }
                                        }
                                    }
                                }
                            }
                            if row-list.preferred-height == 0px: EmptyState {
                                icon: @image-url("../icons/search.svg"); title: @tr("No matching rules");
                                description: @tr("Try another search or forwarding type."); action-text: @tr("Clear filters");
                                action-clicked => { root.search = ""; root.kind-filter = 0; }
                            }
                        }
                    }
                }
            }
        }
        if ForwardingBridge.editor-open: DetailPanel {
            title: ForwardingBridge.draft.id == "" ? @tr("New forwarding rule") : @tr("Edit forwarding rule");
            init => { self.focus(); }
            more-visible: false; primary-text: @tr("Save");
            close => { ForwardingBridge.editor-open = false; ForwardingBridge.message = ""; }
            primary-clicked => { ForwardingBridge.save-rule(); }
            Card { title: @tr("Type");
                Segmented { options: [@tr("Local"), @tr("Remote"), @tr("Dynamic")]; segment-min-width: 64px; current-index <=> ForwardingBridge.draft.kind-index; }
                Text { text: ForwardingBridge.draft.kind-index == 0 ? @tr("Local port to a destination through your SSH host.") : ForwardingBridge.draft.kind-index == 1 ? @tr("SSH host port to a destination through this computer.") : @tr("Local SOCKS5 proxy through your SSH host."); font-size: Theme.font-caption; color: Theme.secondary; wrap: word-wrap; }
            }
            Card { title: @tr("Rule");
                Field { label: @tr("Label"); placeholder: @tr("Development database"); text <=> ForwardingBridge.draft.label; }
                Field { label: @tr("Bind address"); placeholder: @tr("127.0.0.1"); text <=> ForwardingBridge.draft.bind-address; }
                HorizontalLayout { spacing: Theme.space-8; cross-axis-alignment: center;
                    Text { text: ForwardingBridge.draft.kind-index == 1 ? @tr("Remote port") : @tr("Local port"); color: Theme.secondary; font-size: Theme.font-caption; font-weight: 500; horizontal-stretch: 1; }
                    Input { width: 100px; compact: true; text <=> ForwardingBridge.draft.bind-port; placeholder-text: @tr("8080"); }
                }
                if ForwardingBridge.draft.kind-index != 2: Field { label: @tr("Destination host"); placeholder: @tr("127.0.0.1"); text <=> ForwardingBridge.draft.destination-host; }
                if ForwardingBridge.draft.kind-index != 2: HorizontalLayout { spacing: Theme.space-8; cross-axis-alignment: center;
                    Text { text: @tr("Destination port"); color: Theme.secondary; font-size: Theme.font-caption; font-weight: 500; horizontal-stretch: 1; }
                    Input { width: 100px; compact: true; text <=> ForwardingBridge.draft.destination-port; placeholder-text: @tr("5432"); }
                }
            }
            Card { title: @tr("Via");
                Text { text: @tr("SSH host"); color: Theme.secondary; font-size: Theme.font-caption; font-weight: 500; }
                Select { options: ForwardingBridge.hosts; current-index <=> ForwardingBridge.draft.host-index; placeholder: @tr("Select host"); enabled: ForwardingBridge.hosts.length > 0; }
                if ForwardingBridge.hosts.length == 0: Text { text: @tr("Save an SSH host in Hosts and connect to it once first."); color: Theme.secondary; font-size: Theme.font-caption; wrap: word-wrap; }
                Checkbox { text: @tr("Start automatically at launch"); checked <=> ForwardingBridge.draft.auto-start; }
            }
        }
    }
}
