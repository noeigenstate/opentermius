import { ScrollView } from "std-widgets.slint";
import { Theme, Action, Input, Field, PageHeader, PageToolbar, EmptyState, EntityCard, Badge, DetailPanel, Card, Segmented, Dialog, Caption, SectionHeader } from "../common.slint";

export struct KeyRow {
    id: string,
    label: string,
    key-type: string,
    fingerprint: string,
    public-key: string,
    created: string,
}

// Rust reads and drives this page through the global bridge.
export global KeychainBridge {
    in property <[KeyRow]> keys;
    in property <KeyRow> selected;
    in-out property <string> selected-id;
    in-out property <string> rename-text;
    in property <bool> busy;
    in property <string> message;
    in property <bool> message-error;
    in property <bool> passphrase-visible;
    in property <string> passphrase-error;
    in-out property <string> passphrase;
    callback generate(string, int);
    callback import-key();
    callback select-key(string);
    callback rename(string, string);
    callback delete-key(string);
    callback copy-public(string);
    callback save-public(string);
    callback save-private(string);
    callback submit-passphrase(string);
    callback cancel-passphrase();
}

// The bridge remains unchanged: this page manages SSH keys, not password records.
component KeyCard inherits EntityCard {
    in property <KeyRow> entry;
    title: entry.label;
    subtitle: entry.key-type + " · " + entry.fingerprint;
    icon: @image-url("../icons/keychain.svg");
    selected: KeychainBridge.selected-id == entry.id;
    show-more: false;
    Badge { text: "Key"; kind: "accent"; }
}

// Public material stays selectable and read-only without an unthemed TextEdit.
component PublicMaterial inherits Rectangle {
    in property <string> value;
    min-height: 80px;
    background: Theme.field-bg;
    border-radius: Theme.r-field;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
    ScrollView {
        TextInput {
            x: Theme.space-12; y: Theme.space-12;
            width: parent.width - Theme.space-24;
            height: self.preferred-height;
            text: root.value; read-only: true; wrap: word-wrap;
            color: Theme.text; font-size: Theme.font-mono; font-family: Theme.mono-font;
            selection-background-color: Theme.accent-soft;
            selection-foreground-color: Theme.text;
        }
    }
}

export component KeychainPage inherits Rectangle {
    background: Theme.base;
    property <bool> generate-open: false;
    property <bool> delete-open: false;
    property <bool> detail-open: false;
    property <string> search;
    property <string> new-label;
    property <int> new-kind: 0;
    // A generated/imported key is selected by Rust; reveal it after completion.
    private property <string> selection: KeychainBridge.selected-id;
    changed selection => { detail-open = selection != ""; }
    pure function matches(key: KeyRow) -> bool {
        key.label.to-lowercase().replace-all(search.to-lowercase(), "") != key.label.to-lowercase()
        || key.fingerprint.to-lowercase().replace-all(search.to-lowercase(), "") != key.fingerprint.to-lowercase()
        || key.key-type.to-lowercase().replace-all(search.to-lowercase(), "") != key.key-type.to-lowercase()
        || search == ""
    }

    HorizontalLayout { spacing: 0px;
        VerticalLayout { spacing: 0px; horizontal-stretch: 1; min-width: 0px;
            PageHeader {
                search <=> root.search; placeholder: "Search keys";
                primary-text: "New key"; primary-has-icon: true; primary-icon: @image-url("../icons/plus.svg");
                primary-enabled: !KeychainBridge.busy;
                primary-clicked => { root.generate-open = true; }
            }
            PageToolbar {
                Action { text: "Import key"; kind: "secondary"; has-icon: true; icon: @image-url("../icons/arrow-down.svg"); disabled: KeychainBridge.busy; clicked => { KeychainBridge.import-key(); } }
                Action { text: "Generate"; kind: "flat"; disabled: KeychainBridge.busy; clicked => { root.generate-open = true; } }
                Rectangle { horizontal-stretch: 1; }
                Caption { text: KeychainBridge.keys.length == 1 ? "1 key" : KeychainBridge.keys.length + " keys"; }
            }
            if KeychainBridge.message != "": Rectangle {
                height: Theme.space-32; background: Theme.base;
                Text { x: Theme.gutter; width: parent.width - 2 * Theme.gutter; height: parent.height; text: KeychainBridge.message; color: KeychainBridge.message-error ? Theme.danger : Theme.secondary; font-size: Theme.font-caption; vertical-alignment: center; overflow: elide; }
            }
            if KeychainBridge.keys.length == 0: EmptyState {
                vertical-stretch: 1; icon: @image-url("../icons/keychain.svg");
                title: "No keys yet";
                description: "Generate or import SSH keys and reuse them across hosts. Private keys stay encrypted on this computer.";
                action-text: "New key"; action-visible: !KeychainBridge.busy;
                action-clicked => { root.generate-open = true; }
            }
            if KeychainBridge.keys.length > 0: Rectangle {
                vertical-stretch: 1; min-height: 0px;
                if root.search == "": grid := ScrollView {
                    private property <int> columns: Math.max(1, Math.floor((self.visible-width - 2 * Theme.gutter + Theme.space-12) / (300px + Theme.space-12)));
                    private property <length> cell-width: (self.visible-width - 2 * Theme.gutter - (self.columns - 1) * Theme.space-12) / self.columns;
                    content-height: Theme.gutter + 28px + Math.ceil(KeychainBridge.keys.length / self.columns) * (Theme.entity-height + Theme.space-12) + Theme.gutter;
                    SectionHeader { x: Theme.gutter; y: Theme.gutter; width: grid.visible-width - 2 * Theme.gutter; height: Theme.space-16; text: "Keys"; }
                    for key[index] in KeychainBridge.keys: KeyCard {
                        x: Theme.gutter + Math.mod(index, grid.columns) * (grid.cell-width + Theme.space-12);
                        y: Theme.gutter + 28px + Math.floor(index / grid.columns) * (Theme.entity-height + Theme.space-12);
                        width: grid.cell-width; entry: key;
                        clicked => { KeychainBridge.select-key(key.id); root.detail-open = true; }
                    }
                }
                // Search results use a compact column so hidden entries leave no grid holes.
                if root.search != "": Rectangle {
                    results := ScrollView {
                        content-height: result-list.preferred-height;
                        result-list := VerticalLayout {
                            width: results.visible-width; padding: Theme.gutter; spacing: 0px; alignment: start;
                            for key in KeychainBridge.keys: VerticalLayout {
                                spacing: 0px;
                                if root.matches(key): KeyCard { entry: key; clicked => { KeychainBridge.select-key(key.id); root.detail-open = true; } }
                                if root.matches(key): Rectangle { height: Theme.space-12; }
                            }
                        }
                    }
                    if result-list.preferred-height <= 2 * Theme.gutter: EmptyState {
                        icon: @image-url("../icons/search.svg"); title: "No matching keys";
                        description: "Try another label, key type or fingerprint.";
                        action-text: "Clear search"; action-clicked => { root.search = ""; }
                    }
                }
            }
        }
        if root.detail-open && KeychainBridge.selected-id != "": DetailPanel {
            title: "Key details"; more-visible: false; show-delete: true;
            init => { self.focus(); }
            primary-text: "Save label";
            primary-enabled: !KeychainBridge.busy && KeychainBridge.rename-text != "" && KeychainBridge.rename-text != KeychainBridge.selected.label;
            close => { root.detail-open = false; }
            delete-clicked => { root.delete-open = true; }
            primary-clicked => { KeychainBridge.rename(KeychainBridge.selected-id, KeychainBridge.rename-text); }
            Card { title: "Label";
                Input { text <=> KeychainBridge.rename-text; placeholder-text: "Key label"; }
            }
            Card { title: "Type";
                Badge { text: KeychainBridge.selected.key-type; kind: "accent"; }
                Caption { text: "Created " + KeychainBridge.selected.created; overflow: elide; }
            }
            Card { title: "Credentials";
                Text { text: "Fingerprint"; color: Theme.secondary; font-size: Theme.font-caption; font-weight: 500; }
                PublicMaterial { value: KeychainBridge.selected.fingerprint; height: 80px; }
                Text { text: "Public key"; color: Theme.secondary; font-size: Theme.font-caption; font-weight: 500; }
                PublicMaterial { value: KeychainBridge.selected.public-key; height: 144px; }
                Action { text: "Copy public key"; has-icon: true; icon: @image-url("../icons/copy.svg"); clicked => { KeychainBridge.copy-public(KeychainBridge.selected-id); } }
                Action { text: "Save public key..."; kind: "flat"; clicked => { KeychainBridge.save-public(KeychainBridge.selected-id); } }
                Action { text: "Save private key..."; kind: "flat"; clicked => { KeychainBridge.save-private(KeychainBridge.selected-id); } }
            }
        }
    }

    Dialog {
        open <=> root.generate-open; title: "Generate SSH key";
        description: "Private keys are encrypted with Windows DPAPI in local storage.";
        confirm-text: "Generate"; confirm-enabled: !KeychainBridge.busy;
        confirm => { KeychainBridge.generate(root.new-label, root.new-kind); root.generate-open = false; }
        Field { label: "Label"; placeholder: "Key label"; text <=> root.new-label; auto-focus: true; }
        Text { text: "Type"; color: Theme.secondary; font-size: Theme.font-caption; font-weight: 500; }
        Segmented { options: ["Ed25519", "RSA 3072", "RSA 4096"]; current-index <=> root.new-kind; }
        // Leave room for the shared Dialog's scrolling body to paint the last border.
        Rectangle { height: Theme.space-4; }
    }
    Dialog {
        open: KeychainBridge.passphrase-visible; title: "Private key passphrase";
        description: "Enter the passphrase for this encrypted private key.";
        confirm-text: "Import"; confirm-enabled: !KeychainBridge.busy;
        cancel => { KeychainBridge.cancel-passphrase(); }
        confirm => { KeychainBridge.submit-passphrase(KeychainBridge.passphrase); }
        if KeychainBridge.passphrase-error != "": Text { text: KeychainBridge.passphrase-error; color: Theme.danger; font-size: Theme.font-caption; wrap: word-wrap; }
        Input { text <=> KeychainBridge.passphrase; input-type: password; placeholder-text: "Passphrase"; invalid: KeychainBridge.passphrase-error != ""; init => { self.focus(); } }
        Rectangle { height: Theme.space-4; }
    }
    Dialog {
        open <=> root.delete-open; title: "Delete key"; confirm-text: "Delete"; confirm-kind: "danger";
        description: "Delete “" + KeychainBridge.selected.label + "”? This cannot be undone. Hosts using this key must be changed first.";
        confirm-enabled: !KeychainBridge.busy;
        confirm => { root.delete-open = false; KeychainBridge.delete-key(KeychainBridge.selected-id); }
    }
}
