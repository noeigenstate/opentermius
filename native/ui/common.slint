// Shared theme and controls used by the main window and the section pages.
export global Theme {
    out property <color> base: #edf1f2;
    out property <color> lowest: #282b3d;
    out property <color> high: #f7f9fa;
    out property <color> highest: #ffffff;
    out property <color> border: #d5dde0;
    out property <color> secondary: #798c94;
    out property <color> text: #141729;
    out property <color> accent: #2091f6;
}
export component Action inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> disabled: false;
    in property <bool> flat: false;
    in property <bool> has-icon: false;
    in property <image> icon;
    in property <bool> secondary: false;
    in property <bool> left-aligned: false;
    in property <length> text-size: 14px;
    out property <bool> hovered: touch.has-hover;
    callback clicked;
    min-height: 30px; max-height: 30px; min-width: label.preferred-width + 22px + (root.has-icon ? 20px : 0px); border-radius: 5px;
    background: root.disabled ? (root.flat ? transparent : #798c9426) : touch.has-hover ? (root.primary ? #58adf8 : Theme.border) : root.primary ? Theme.accent : root.flat ? transparent : #798c9426;
    HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 6px;
        if root.has-icon: Rectangle { width: 14px; background: transparent;
            Image { source: root.icon; colorize: root.disabled ? #a4b3ba : root.primary ? white : root.secondary ? Theme.secondary : Theme.text; width: 14px; height: 14px; x: 0px; y: (parent.height - 14px) / 2; }
        }
        label := Text { text: root.text; color: root.disabled ? #a4b3ba : root.primary ? white : root.secondary ? Theme.secondary : Theme.text; font-size: root.text-size; font-weight: root.secondary ? 450 : 500; horizontal-alignment: root.left-aligned ? left : center; vertical-alignment: center; }
    }
    touch := TouchArea { enabled: !root.disabled; clicked => { root.clicked(); } }
}
export component Input inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <color> placeholder-color: #a4b3ba;
    in property <InputType> input-type: InputType.text;
    in property <bool> enabled: true;
    in property <bool> has-leading-icon: false;
    in property <image> leading-icon;
    property <bool> secret-visible: false;
    callback accepted;
    callback edited;
    forward-focus: edit;
    min-height: 36px; max-height: 36px; preferred-height: 36px; min-width: 0px;
    border-width: 1px; border-color: edit.has-focus ? Theme.accent : #d5dde0;
    border-radius: 10px; background: transparent;
    Image { source: root.leading-icon; colorize: #a4b3ba; visible: root.has-leading-icon; x: 10px; y: (parent.height - 14px) / 2; width: 14px; height: 14px; }
    Text { x: root.has-leading-icon ? 32px : 10px; width: parent.width - self.x - 10px; text: root.placeholder-text; color: root.placeholder-color; vertical-alignment: center; visible: root.text == ""; }
    edit := TextInput { x: root.has-leading-icon ? 32px : 10px; width: parent.width - self.x - (root.input-type == InputType.password ? 34px : 10px); y: (parent.height - self.height) / 2; height: 22px;
        text <=> root.text; color: Theme.text; font-size: 14px; single-line: true; input-type: root.secret-visible ? InputType.text : root.input-type; enabled: root.enabled;
        selection-background-color: #2091f640; selection-foreground-color: Theme.text;
        accepted => { root.accepted(); } edited => { root.edited(); }
    }
    if root.input-type == InputType.password: Rectangle { x: parent.width - 30px; width: 28px; background: transparent;
        Image { source: @image-url("icons/eye-off.svg"); width: 14px; height: 14px; x: 7px; y: (parent.height - 14px) / 2; }
        TouchArea { enabled: root.enabled; clicked => { root.secret-visible = !root.secret-visible; edit.focus(); } }
    }
}
export component NavItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked;
    height: 36px; border-radius: 5px;
    background: root.active ? #798c941a : area.has-hover && root.enabled ? #798c941a : transparent;
    HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 13px;
        Rectangle { width: 14px; background: transparent;
            Image { source: root.icon; colorize: Theme.text; image-fit: contain; x: 0px; y: (parent.height - 14px) / 2; width: 14px; height: 14px; }
        }
        Text { text: root.text; color: Theme.text; font-size: 14px; min-width: 100px; vertical-alignment: center; }
    }
    area := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}
export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> secret: false;
    in property <bool> auto-focus: false;
    in-out property <string> text;
    spacing: 6px;
    Text { text: root.label; color: Theme.secondary; font-size: 12px; height: 18px; }
    Input { text <=> root.text; placeholder-text: root.placeholder; input-type: root.secret ? InputType.password : InputType.text; height: 36px; init => { if root.auto-focus { self.focus(); } } }
}
