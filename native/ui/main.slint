import { ScrollView, ListView } from "std-widgets.slint";
import { Theme, Action, Input, NavItem, Field, IconButton, EmptyState, Badge, Card, EntityCard, Select, Popover, MenuItem, MenuSeparator, Dialog, Segmented } from "common.slint";
import { KeychainBridge, KeychainPage } from "pages/keychain.slint";
import { SnippetsBridge, SnippetsPage, SnippetRow } from "pages/snippets.slint";
import { KnownHostsBridge, KnownHostsPage, KnownHostRow } from "pages/known_hosts.slint";
import { LogsBridge, LogsPage, LogRow } from "pages/logs.slint";
import { SettingsBridge, SettingsPage } from "pages/settings.slint";
import { RecoveryBridge, RecoveryPanel } from "pages/recovery.slint";
import { GalleryPage } from "pages/gallery.slint";
export { KeychainBridge }
export { SnippetsBridge }
export { KnownHostsBridge }
export { KnownHostRow }
export { LogsBridge }
export { SettingsBridge }
export { Theme }
export { RecoveryBridge }
export { SnippetRow }
export { LogRow }

export struct HostRow { id: string, name: string, address: string, group: string, auth: string, has-secret: bool, tags: string }
export struct TabRow { id: string, title: string, status: string, disconnected: bool, local: bool }
export struct TerminalRun { text: string, row: int, col: int, width: int, fg: color, bg: color, bold: bool, underline: bool }
export struct SelectionRun { row: int, col: int, width: int }
export struct FileRow { name: string, is-directory: bool, size: string, modified: string, kind: string, permissions: string }
export struct TransferRow { id: string, name: string, detail: string, percent: int, pending: bool }
export struct GroupRow { name: string, count: int }
export struct TagRow { name: string, count: int }
export struct HostDraft { id: string, name: string, host: string, port: string, username: string, group: string, auth-index: int, key-path: string, key-id: string, secret: string, remember: bool, tags: string }

component FileTableRow inherits Rectangle {
    in property <FileRow> file;
    in property <bool> heading: false;
    in property <bool> remote: false;
    in property <string> sort-column;
    in property <bool> ascending: true;
    private property <[float]> cols: root.remote ? [0.33, 0.22, 0.12, 0.13, 0.20] : [0.44, 0.24, 0.16, 0.16];
    private property <[float]> starts: [0, root.cols[0], root.cols[0] + root.cols[1], root.cols[0] + root.cols[1] + root.cols[2], root.cols[0] + root.cols[1] + root.cols[2] + root.cols[3]];
    private property <[string]> labels: root.remote ? [@tr("Name"), @tr("Modified"), @tr("Size"), @tr("Kind"), @tr("Permissions")] : [@tr("Name"), @tr("Modified"), @tr("Size"), @tr("Kind")];
    private property <[string]> sort-keys: ["name", "date", "size", "kind", ""];
    callback sort(string);
    height: root.heading ? Theme.table-header-height : 36px;
    background: Theme.highest;
    // Shared TableHeader cells have no fixed height, leaving their hit areas empty.
    // Explicit geometry keeps the headers sortable while sharing the row column widths.
    if root.heading: Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height; background: Theme.high;
        for label[index] in root.labels: Rectangle {
            x: parent.width * root.starts[index]; y: 0px; width: parent.width * root.cols[index]; height: parent.height;
            Text { x: index == 0 ? 16px : 12px; y: 0px; width: Math.max(0px, parent.width - self.x - 24px); height: parent.height;
                text: label; color: Theme.secondary; font-size: Theme.font-caption; font-weight: 500; overflow: elide; vertical-alignment: center;
            }
            if root.sort-keys[index] != "" && root.sort-column == root.sort-keys[index]: Image {
                source: root.ascending ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg"); colorize: Theme.secondary;
                x: parent.width - 24px; y: 10px; width: 12px; height: 12px;
            }
            if index + 1 < root.labels.length: Rectangle { x: parent.width - 1px; y: 0px; width: 1px; height: parent.height; background: Theme.divider; }
            TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; enabled: index < 4; mouse-cursor: pointer; clicked => { root.sort(root.sort-keys[index]); } }
        }
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.divider; }
    }
    if !root.heading: Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height;
        Image { source: root.file.is-directory ? @image-url("icons/folder-filled.svg") : @image-url("icons/file.svg"); colorize: root.file.is-directory ? Theme.folder : Theme.secondary; x: 16px; y: 9px; width: 18px; height: 18px; }
        Text { x: 44px; width: parent.width * root.cols[0] - 52px; height: parent.height; text: root.file.name; color: Theme.text; font-weight: 500; font-size: Theme.font-body; overflow: elide; vertical-alignment: center; }
        for value[index] in [root.file.modified, root.file.size, root.file.kind, root.file.permissions]: Rectangle {
            visible: index < 3 || root.remote;
            x: parent.width * root.starts[index + 1];
            width: parent.width * (index + 1 < root.cols.length ? root.cols[index + 1] : 0); height: parent.height;
            Text { x: 12px; width: Math.max(0px, parent.width - 20px); height: parent.height; text: value; color: Theme.secondary; font-size: index == 3 ? 12px : 13px; font-family: index == 3 ? Theme.mono-font : Theme.ui-font; overflow: elide; vertical-alignment: center; }
        }
        Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.divider; }
    }
}

// Starts the native move only once the pointer really drags, so a plain click on the
// title bar never enters the OS move loop.
component WindowDragArea inherits TouchArea {
    callback drag;
    moved => { if self.pressed && (Math.abs(self.mouse-x - self.pressed-x) > 4px || Math.abs(self.mouse-y - self.pressed-y) > 4px) { root.drag(); } }
}

export component AppWindow inherits Window {
    no-frame: true;
    title: @tr("OpenTermius"); preferred-width: 1240px; preferred-height: 800px; min-width: 900px; min-height: 600px;
    icon: @image-url("../../assets/icon.png");
    background: Theme.base; default-font-family: Theme.ui-font; default-font-size: Theme.font-body;
    in property <[HostRow]> hosts;
    in property <[GroupRow]> groups;
    in property <[TabRow]> tabs;
    in property <[TerminalRun]> terminal-runs;
    in property <string> terminal-font: Theme.mono-font;
    in property <[SelectionRun]> selection-runs;
    in property <int> cursor-row;
    in property <int> cursor-col;
    in property <bool> cursor-visible;
    in property <string> active-session;
    in property <string> active-host;
    in property <bool> remote-connected;
    in property <bool> local-session;
    in property <bool> terminal-visible;
    in property <bool> reconnect-hint: false;
    out property <bool> terminal-has-focus: terminal-focus.has-focus && !root.hosts-page && !root.sftp-page && !root.prompt-visible;
    in property <string> status-text;
    in property <bool> status-error;
    in property <[FileRow]> files;
    in property <[FileRow]> local-files;
    in property <string> local-path;
    in property <[TransferRow]> transfers;
    in-out property <string> local-selection;
    in-out property <string> remote-selection;
    in-out property <bool> show-hidden <=> SettingsBridge.show-hidden-files;
    in-out property <string> local-sort: "name";
    in-out property <string> remote-sort: "name";
    in-out property <bool> local-ascending: true;
    in-out property <bool> remote-ascending: true;
    property <int> file-actions-pane: 0;
    property <length> file-actions-x;
    property <length> file-actions-y;
    property <string> file-dialog;
    property <bool> file-dialog-local;
    property <string> file-dialog-source;
    property <string> file-dialog-value;
    in-out property <bool> sftp-page: false;
    in-out property <string> tab-menu-session: "";
    in-out property <bool> tab-menu-reconnectable: false;
    in-out property <length> tab-menu-x: 0px;
    in property <string> file-path;
    in property <bool> file-busy;
    in property <color> terminal-background: Theme.terminal-bg;
    in property <color> terminal-cursor: Theme.terminal-cursor;
    in-out property <bool> bell-flash: false;
    property <length> terminal-font-size: SettingsBridge.terminal-font-size * 1px;
    property <bool> terminal-cursor-blink: SettingsBridge.cursor-blink;
    property <bool> cursor-phase: true;
    property <length> cell-height-px: Math.max(1px, terminal-line-metric.preferred-height / 10);
    in property <string> prompt-title;
    in property <string> prompt-message;
    in property <bool> prompt-is-key;
    in property <bool> prompt-password;
    in-out property <string> prompt-answer;
    in property <bool> prompt-visible;
    property <length> cell-advance: Math.max(1px, terminal-metric.preferred-width / 40);
    out property <int> terminal-cols: Math.max(20, Math.floor((terminal-area.width - 20px) / root.cell-advance));
    out property <int> terminal-rows: Math.max(5, Math.floor((terminal-area.height - 16px) / root.cell-height-px));
    out property <float> cell-width: root.cell-advance / 1px;
    out property <float> cell-height: root.cell-height-px / 1px;
    property <bool> hosts-page: true;
    // Sidebar section shown while hosts-page is true: hosts, keychain, snippets, known-hosts, logs, settings.
    in-out property <string> section: "hosts";
    property <bool> host-section: root.hosts-page && root.section == "hosts";
    property <bool> editor-open: false;
    property <bool> creating-host: false;
    property <bool> editor-menu-open: false;
    in-out property <bool> menu-open: false;
    property <length> session-bar-height: 40px;
    // Mirrors sftp-page for the session switch (Rust restores the mode per tab).
    in-out property <int> session-view-index: 0;
    changed sftp-page => { root.session-view-index = root.sftp-page ? 1 : 0; }
    in-out property <HostDraft> draft;
    in-out property <string> search;
    property <string> quick-host;
    in-out property <string> selected-host;
    in-out property <string> selected-host-name;
    in-out property <int> host-selection-index: -1;
    property <bool> editor-focus-requested: false;
    property <bool> search-focus-requested: false;
    property <length> selection-scroll-y;
    in-out property <string> host-view-mode: "grid";
    in-out property <string> host-sort-mode: "name";
    in-out property <string> host-tag-filter: "";
    in property <[TagRow]> host-tags;
    property <bool> tag-menu-open: false;
    property <bool> sort-menu-open: false;
    property <length> toolbar-popup-x;
    property <length> toolbar-popup-y;
    property <bool> host-menu-open: false;
    property <string> host-menu-id;
    property <string> host-menu-name;
    property <length> host-menu-x;
    property <length> host-menu-y;
    property <bool> delete-open: false;
    property <string> delete-id;
    property <string> delete-name;
    property <bool> group-editing: false;
    property <[GroupRow]> group-suggestions;
    property <bool> group-rename-open: false;
    property <string> group-rename-old;
    property <string> group-rename-value;
    property <int> grid-cols: Math.max(1, Math.floor((host-grid.width - 2 * Theme.gutter + 12px) / 312px));
    property <length> grid-cell-width: (host-grid.width - 2 * Theme.gutter - (root.grid-cols - 1) * 12px) / root.grid-cols;
    property <length> group-height: root.groups.length > 0 ? Theme.space-20 + Theme.space-24 + Math.ceil(root.groups.length / root.grid-cols) * 72px : 0px;
    property <int> draft-count: root.editor-open && root.creating-host ? 1 : 0;
    callback save-host(HostDraft) -> bool;
    callback save-and-connect(HostDraft);
    callback quick-connect(string);
    callback edit-host(string) -> HostDraft;
    callback delete-host(string);
    callback connect-host(string);
    callback open-terminal;
    callback select-session(string);
    callback close-session(string);
    callback terminal-key(string, bool, bool, bool);
    callback terminal-size(int, int);
    callback terminal-scroll(int);
    callback terminal-pointer(int, int, int, int, bool, bool, bool);
    callback terminal-wheel(int, int, int, bool, bool, bool);
    callback terminal-ime(string);
    callback reconnect-session(string);
    callback duplicate-session(string);
    callback copy-terminal;
    callback paste-terminal;
    callback list-files(string);
    callback session-sftp(bool);
    callback list-local(string);
    callback upload-local(string);
    callback download-to-local(string);
    callback upload-file;
    callback upload-folder;
    callback file-operation(bool, string, string, string);
    callback update-file-view;
    callback cancel-transfer(string);
    callback download-file(string);
    callback import-hosts;
    callback import-xshell;
    callback import-windterm;
    callback export-hosts;
    callback search-hosts(string);
    callback select-group(string);
    callback set-host-view(string);
    callback set-host-sort(string);
    callback set-host-tag-filter(string);
    callback move-host-selection(int);
    callback duplicate-host(string);
    callback copy-host-address(string);
    callback open-host-sftp(string);
    callback rename-group(string, string);
    callback suggest-host-groups(string) -> [GroupRow];
    callback pick-key() -> string;
    callback select-terminal(int, int, bool);
    callback end-terminal-selection;
    callback answer-prompt(bool, string);
    callback window-drag;
    callback window-minimize;
    callback window-maximize;
    callback window-close;
    // Like xterm.js' fit addon: never size the PTY from a hidden or collapsed terminal
    // (it would shrink the remote screen to a few rows), and refit when it shows again.
    out property <bool> terminal-shown: !root.hosts-page && !root.sftp-page && terminal-area.height > root.cell-height-px * 2;
    changed terminal-cols => { if root.terminal-shown { root.terminal-size(root.terminal-cols, root.terminal-rows); } }
    changed terminal-rows => { if root.terminal-shown { root.terminal-size(root.terminal-cols, root.terminal-rows); } }
    changed terminal-shown => { if root.terminal-shown { root.terminal-size(root.terminal-cols, root.terminal-rows); } }
    changed terminal-cursor-blink => { root.cursor-phase = true; }
    changed active-session => {
        root.file-dialog = "";
        if root.active-session != "" { root.hosts-page = false; if !root.sftp-page { terminal-focus.focus(); } }
        else if !root.sftp-page { root.hosts-page = true; }
    }
    public function new-host() {
        if !root.save-current-draft() { return; }
        root.draft = root.edit-host(""); root.draft.port = ""; root.creating-host = true; root.editor-open = true; root.editor-menu-open = false;
        root.selected-host = root.draft.id; root.selected-host-name = ""; root.editor-focus-requested = true; root.group-editing = false;
    }
    public function save-current-draft() -> bool {
        if root.editor-open && root.draft.host != "" { return root.save-host(root.draft); }
        return true;
    }
    public function open-editor(host-id: string) {
        if root.editor-open && root.draft.id == host-id { return; }
        if !root.save-current-draft() { return; }
        root.draft = root.edit-host(host-id); root.selected-host = host-id; root.creating-host = false; root.editor-open = true; root.editor-menu-open = false; root.editor-focus-requested = true;
        root.group-editing = false;
    }
    public function activate-host(host-id: string) {
        if !root.save-current-draft() { return; }
        root.close-editor(); root.selected-host = host-id; root.connect-host(host-id);
    }
    public function focus-terminal() { terminal-focus.focus(); }
    public function open-section(name: string) { if root.save-current-draft() { root.close-editor(); if name == "recovery" { RecoveryBridge.visible = true; } else { root.sftp-page = false; root.hosts-page = true; root.section = name; } } }
    public function activate-session(session-id: string) { if root.save-current-draft() { root.close-editor(); root.hosts-page = false; root.select-session(session-id); if !root.sftp-page { terminal-focus.focus(); } } }
    public function close-editor() { root.editor-open = false; root.creating-host = false; root.editor-menu-open = false; root.editor-focus-requested = false; root.group-editing = false; root.draft.secret = ""; }
    public function open-host-menu(id: string, name: string, x: length, y: length) {
        host-focus.focus();
        root.selected-host = id; root.selected-host-name = name;
        root.host-menu-id = id; root.host-menu-name = name; root.host-menu-x = x; root.host-menu-y = y;
        root.host-menu-open = true; root.tag-menu-open = false; root.sort-menu-open = false;
    }
    public function ask-delete(id: string, name: string) {
        host-focus.focus();
        root.delete-id = id; root.delete-name = name; root.delete-open = true; root.host-menu-open = false;
    }
    function reveal-selection(y: length, height: length, viewport: length, current: length) {
        if y < -current { root.selection-scroll-y = -y; }
        else if y + height > viewport - current { root.selection-scroll-y = viewport - y - height; }
        else { root.selection-scroll-y = current; }
    }
    page-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape && root.group-rename-open { root.group-rename-open = false; accept }
            else if event.text == Key.Escape && root.delete-open { root.delete-open = false; accept }
            else if event.text == Key.Escape && (root.tag-menu-open || root.sort-menu-open || root.host-menu-open) { root.tag-menu-open = false; root.sort-menu-open = false; root.host-menu-open = false; accept }
            else if root.host-section && !root.delete-open && !root.group-rename-open && event.modifiers.control && (event.text == "f" || event.text == "F") { root.search-focus-requested = true; accept }
            else if event.text == Key.Escape && root.group-editing { root.group-editing = false; accept }
            else if event.text == Key.Escape && root.editor-open { if root.save-current-draft() { root.close-editor(); } accept }
            else { reject }
        }
    terminal-metric := Text { text: "MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM"; font-family: root.terminal-font; font-size: root.terminal-font-size; font-weight: 400; opacity: 0; }
    terminal-line-metric := Text { text: "M\nM\nM\nM\nM\nM\nM\nM\nM\nM"; font-family: root.terminal-font; font-size: root.terminal-font-size; font-weight: 400; opacity: 0; }
    Timer { interval: 500ms; running: root.terminal-cursor-blink && root.cursor-visible && !root.hosts-page; triggered => { root.cursor-phase = !root.cursor-phase; } }
    Timer { interval: 150ms; running: root.bell-flash; triggered => { root.bell-flash = false; } }
    VerticalLayout { spacing: 0px;
        Rectangle { height: Theme.titlebar-height; background: Theme.lowest;
            WindowDragArea { drag => { root.window-drag(); } double-clicked => { root.window-maximize(); } }
            HorizontalLayout { x: 9px; y: 9px; width: parent.width - 19px; height: 32px; spacing: 6px; cross-axis-alignment: center;
                Rectangle { width: 30px; height: 30px; border-radius: Theme.r-control; background: menu-touch.has-hover ? Theme.tab-hover : transparent;
                    Image { source: @image-url("icons/menu.svg"); colorize: Theme.titlebar-fg; x: 7px; y: 7px; width: 16px; height: 16px; }
                    menu-touch := TouchArea { mouse-cursor: pointer; clicked => { root.menu-open = !root.menu-open; } }
                }
                Rectangle { width: 150px; height: 32px; border-radius: Theme.r-field;
                    background: root.hosts-page ? Theme.tab-active : home-touch.has-hover ? Theme.tab-hover : Theme.tab-bg;
                    HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 8px; cross-axis-alignment: center;
                        Image { source: @image-url("../../assets/logo.svg"); width: 18px; height: 18px; }
                        Text { text: root.section == "keychain" ? @tr("Keychain") : root.section == "snippets" ? @tr("Snippets") : root.section == "known-hosts" ? @tr("Known Hosts") : root.section == "logs" ? @tr("Logs") : root.section == "settings" ? @tr("Settings") : root.section == "gallery" ? @tr("Gallery") : @tr("Hosts"); color: Theme.on-accent; font-size: Theme.font-body; font-weight: 500; overflow: elide; }
                    }
                    if root.hosts-page: Rectangle { x: 10px; y: 30px; width: parent.width - 20px; height: 2px; border-radius: 1px; background: Theme.accent; }
                    home-touch := TouchArea { mouse-cursor: pointer; clicked => { root.sftp-page = false; root.hosts-page = true; } }
                }
                Rectangle { width: 30px; height: 30px; border-radius: Theme.r-control; background: plus-touch.has-hover ? Theme.tab-hover : transparent;
                    Image { source: @image-url("icons/plus.svg"); colorize: Theme.titlebar-fg; x: 7px; y: 7px; width: 16px; height: 16px; }
                    plus-touch := TouchArea { mouse-cursor: pointer; clicked => { if root.save-current-draft() { root.close-editor(); root.sftp-page = false; root.open-terminal(); } } }
                }
                tab-strip := Flickable { horizontal-stretch: 1; height: 32px; content-height: self.height;
                    property <length> tab-width: Math.max(120px, Math.min(160px, self.width / Math.max(1, root.tabs.length) - 6px));
                    content-width: root.tabs.length * (self.tab-width + 6px);
                    WindowDragArea { width: Math.max(tab-strip.width, tab-strip.content-width); height: 32px; drag => { root.window-drag(); } double-clicked => { root.window-maximize(); } }
                    for tab[index] in root.tabs: tab-item := Rectangle { x: index * (tab-strip.tab-width + 6px); y: 0px; width: tab-strip.tab-width; height: 32px; border-radius: Theme.r-field;
                        property <bool> active: !root.hosts-page && root.active-session == tab.id;
                        property <bool> hovered: tab-touch.has-hover || tab-menu-touch.has-hover || tab-close-touch.has-hover;
                        background: self.active ? Theme.tab-active : self.hovered ? Theme.tab-hover : Theme.tab-bg;
                        // Covers the whole tab, underneath the buttons, so hovering anywhere shows the close button.
                        tab-touch := TouchArea { mouse-cursor: pointer;
                            clicked => { root.activate-session(tab.id); }
                            pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.right { root.tab-menu-session = tab.id; root.tab-menu-reconnectable = tab.disconnected && !tab.local; root.tab-menu-x = Math.min(self.absolute-position.x, root.width - 210px); } }
                        }
                        HorizontalLayout { padding-left: 10px; padding-right: 4px; spacing: 4px; cross-axis-alignment: center;
                            Image { source: @image-url("icons/terminal.svg"); colorize: tab.status == "connected" ? Theme.success : tab.disconnected ? Theme.warning : Theme.titlebar-fg; width: 16px; height: 16px; }
                            Text { text: tab.title; color: Theme.on-accent; font-size: Theme.font-body; font-weight: 500; overflow: elide; horizontal-stretch: 1; }
                            Rectangle { width: 20px; height: 20px; border-radius: Theme.r-control; background: tab-menu-touch.has-hover ? Theme.tab-hover : transparent;
                                Image { source: @image-url("icons/more.svg"); colorize: Theme.titlebar-fg; x: 3px; y: 3px; width: 14px; height: 14px; }
                                tab-menu-touch := TouchArea { clicked => { root.tab-menu-session = tab.id; root.tab-menu-reconnectable = tab.disconnected && !tab.local; root.tab-menu-x = Math.min(self.absolute-position.x, root.width - 210px); } }
                            }
                            // Always clickable; only its visibility follows hover, so moving straight onto it works.
                            Rectangle { width: 24px; height: 24px; opacity: tab-item.active || tab-item.hovered ? 1 : 0; border-radius: Theme.r-control; background: tab-close-touch.has-hover ? Theme.tab-hover : transparent;
                                Image { source: @image-url("icons/close.svg"); colorize: Theme.on-accent; x: 6px; y: 6px; width: 12px; height: 12px; }
                                tab-close-touch := TouchArea { clicked => { root.close-session(tab.id); } }
                            }
                        }
                        if self.active: Rectangle { x: 10px; y: 30px; width: parent.width - 20px; height: 2px; border-radius: 1px; background: Theme.accent; }
                    }
                }
                for chrome in [{icon:@image-url("icons/minimize.svg"),action:0},{icon:@image-url("icons/maximize.svg"),action:1},{icon:@image-url("icons/close.svg"),action:2}]: Rectangle {
                    width: 30px; height: 30px; border-radius: Theme.r-control; background: chrome-touch.has-hover ? (chrome.action == 2 ? Theme.danger : Theme.tab-hover) : transparent;
                    Image { source: chrome.icon; colorize: chrome.action == 2 && chrome-touch.has-hover ? Theme.on-accent : Theme.titlebar-fg; width: 16px; height: 16px; x: 7px; y: 7px; }
                    chrome-touch := TouchArea { clicked => { if chrome.action == 0 { root.window-minimize(); } else if chrome.action == 1 { root.window-maximize(); } else if root.save-current-draft() { root.close-editor(); root.window-close(); } } }
                }
            }
        }
        HorizontalLayout { spacing: 0px;
            Rectangle { width: Theme.sidebar-width; background: Theme.high;
                VerticalLayout { padding: 10px; spacing: 2px;
                    NavItem { text: @tr("Hosts"); icon: @image-url("icons/hosts.svg"); active: root.host-section; clicked => { root.section = "hosts"; root.hosts-page = true; root.search = ""; root.select-group(""); root.search-hosts(""); } }
                    NavItem { text: @tr("Keychain"); icon: @image-url("icons/keychain.svg"); active: root.hosts-page && root.section == "keychain"; clicked => { root.open-section("keychain"); } }
                    NavItem { text: @tr("Snippets"); icon: @image-url("icons/snippets.svg"); active: root.hosts-page && root.section == "snippets"; clicked => { root.open-section("snippets"); } }
                    NavItem { text: @tr("Known Hosts"); icon: @image-url("icons/known.svg"); active: root.hosts-page && root.section == "known-hosts"; clicked => { root.open-section("known-hosts"); } }
                    NavItem { text: @tr("Logs"); icon: @image-url("icons/history.svg"); active: root.hosts-page && root.section == "logs"; clicked => { root.open-section("logs"); } }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    NavItem { text: @tr("Settings"); icon: @image-url("icons/settings.svg"); active: root.hosts-page && root.section == "settings"; clicked => { root.open-section("settings"); } }
                }
            }
            Rectangle { width: 1px; background: Theme.divider; }
            Rectangle { horizontal-stretch: 1; background: Theme.base;
                VerticalLayout { spacing: 0px;
                    if root.host-section: Rectangle { height: Theme.header-height; background: Theme.high;
                        Timer { interval: 16ms; running: root.search-focus-requested; triggered => { search-input.focus(); root.search-focus-requested = false; } }
                        HorizontalLayout { cross-axis-alignment: center; padding-top: 10px; padding-bottom: 10px; padding-left: Theme.gutter; padding-right: Theme.gutter; spacing: 10px;
                            Rectangle { horizontal-stretch: 1; height: 36px; background: Theme.search-bg; border-width: 1px; border-color: Theme.border; border-radius: Theme.r-field;
                                HorizontalLayout { cross-axis-alignment: center; padding: 5px; spacing: 0px;
                                    search-input := Input { search: true; has-leading-icon: true; leading-icon: @image-url("icons/search.svg"); border-width: 0px; min-height: 24px; max-height: 24px; placeholder-color: Theme.secondary; placeholder-text: @tr("Type \"ssh user@hostname -p port\" to connect..."); text <=> root.search; horizontal-stretch: 1; edited => { root.search-hosts(self.text); } accepted => { root.quick-connect(self.text); } }
                                    Action { kind: "secondary"; text: @tr("Connect"); size: "s"; disabled: root.search == ""; clicked => { root.quick-connect(root.search); } }
                                }
                            }
                            Action { text: @tr("New host"); kind: "primary"; size: "l"; has-icon: true; icon: @image-url("icons/plus.svg"); clicked => { root.new-host(); } }
                        }
                    }
                    host-grid := Rectangle { visible: root.host-section; vertical-stretch: root.host-section ? 1 : 0; min-height: 0px; max-height: root.host-section ? 100000px : 0px; background: Theme.base;
                        host-focus := FocusScope {
                            init => { self.focus(); }
                            key-pressed(event) => {
                                if root.delete-open && event.text == Key.Escape { root.delete-open = false; accept }
                                else if root.group-rename-open && event.text == Key.Escape { root.group-rename-open = false; accept }
                                else if (root.tag-menu-open || root.sort-menu-open || root.host-menu-open) && event.text == Key.Escape { root.tag-menu-open = false; root.sort-menu-open = false; root.host-menu-open = false; accept }
                                else if root.delete-open || root.group-rename-open || root.tag-menu-open || root.sort-menu-open || root.host-menu-open { accept }
                                else if root.editor-open { reject }
                                else if event.text == Key.Return && root.selected-host != "" { root.activate-host(root.selected-host); accept }
                                else if event.text == Key.Delete && root.selected-host != "" { root.ask-delete(root.selected-host, root.selected-host-name); accept }
                                else if event.text == Key.UpArrow { root.move-host-selection(root.host-view-mode == "grid" ? -root.grid-cols : -1); accept }
                                else if event.text == Key.DownArrow { root.move-host-selection(root.host-view-mode == "grid" ? root.grid-cols : 1); accept }
                                else if event.text == Key.LeftArrow { root.move-host-selection(-1); accept }
                                else if event.text == Key.RightArrow { root.move-host-selection(1); accept }
                                else { reject }
                            }
                        }
                        if root.hosts.length == 0 && !root.editor-open: EmptyState {
                            icon: @image-url("icons/hosts.svg");
                            title: root.host-tag-filter != "" ? @tr("No hosts with this tag") : root.search == "" ? @tr("No hosts yet") : @tr("No matching hosts");
                            description: root.host-tag-filter != "" ? @tr("Clear the tag filter or add the tag to a host.") : root.search == "" ? @tr("Save your connection details as hosts to connect in one click.") : @tr("Try another label, address, or group.");
                            action-text: @tr("New host"); action-visible: root.search == "" && root.host-tag-filter == "";
                            action-clicked => { root.new-host(); }
                        }
                        if (root.hosts.length > 0 || root.editor-open) && root.host-view-mode == "grid": ScrollView {
                            property <int> selection-index: root.host-selection-index;
                            changed selection-index => {
                                if self.selection-index >= 0 {
                                    root.reveal-selection(root.group-height + 52px + Math.floor((self.selection-index + root.draft-count) / root.grid-cols) * 72px, 60px, self.height, self.content-y);
                                    self.content-y = root.selection-scroll-y;
                                }
                            }
                            content-height: root.group-height + 72px + Math.ceil((root.hosts.length + root.draft-count) / root.grid-cols) * 72px;
                            if root.groups.length > 0: Text { x: Theme.gutter; y: 20px; width: parent.width - 40px; height: 20px; text: @tr("Groups"); color: Theme.text; font-weight: 600; font-size: Theme.font-body; }
                            for group[index] in root.groups: EntityCard {
                                x: Theme.gutter + Math.mod(index, root.grid-cols) * (root.grid-cell-width + 12px);
                                y: 52px + Math.floor(index / root.grid-cols) * 72px;
                                width: root.grid-cell-width;
                                title: group.name; subtitle: group.count + (group.count == 1 ? @tr(" host") : @tr(" hosts")); icon: @image-url("icons/hosts.svg");
                                clicked => { root.host-tag-filter = ""; root.set-host-tag-filter(""); root.search = group.name; root.select-group(group.name); }
                                more-clicked => { root.group-rename-old = group.name; root.group-rename-value = group.name; root.group-rename-open = true; }
                            }
                            Text { x: Theme.gutter; y: 20px + root.group-height; width: parent.width - 40px; height: 20px; text: @tr("Hosts"); color: Theme.text; font-weight: 600; font-size: Theme.font-body; }
                            if root.host-tag-filter != "": Rectangle { x: 80px; y: root.group-height + 17px; width: 150px; height: 24px; border-radius: 6px; background: Theme.accent-soft;
                                HorizontalLayout { cross-axis-alignment: center; padding-left: 8px; padding-right: 4px; spacing: 4px;
                                    Text { text: @tr("#") + root.host-tag-filter; color: Theme.accent; font-size: Theme.font-caption; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                    Text { text: @tr("×"); color: Theme.accent; font-size: Theme.font-mono; vertical-alignment: center; }
                                }
                                TouchArea { clicked => { root.host-tag-filter = ""; root.set-host-tag-filter(""); } }
                            }
                            if root.draft-count > 0: Rectangle {
                                x: Theme.gutter; y: root.group-height + 52px; width: root.grid-cell-width; height: 60px; border-radius: Theme.r-card;
                                background: Theme.highest; border-width: 2px; border-color: Theme.accent;
                                HorizontalLayout { cross-axis-alignment: center; padding: 12px; spacing: 14px;
                                    Rectangle { width: 36px; height: 36px; border-radius: Theme.r-field; background: Theme.tile-host;
                                        Image { source: @image-url("icons/hosts.svg"); colorize: Theme.on-accent; x: 8px; y: 8px; width: 20px; height: 20px; }
                                    }
                                    VerticalLayout { spacing: 0px;
                                        Text { text: root.draft.name != "" ? root.draft.name : root.draft.host != "" ? root.draft.host : @tr("Enter IP or Hostname..."); color: root.draft.host == "" ? Theme.secondary : Theme.text; font-size: Theme.font-body; overflow: elide; }
                                        Text { text: @tr("ssh"); color: Theme.secondary; font-size: Theme.font-caption; }
                                    }
                                }
                            }
                            for host[index] in root.hosts: Rectangle {
                                x: Theme.gutter + Math.mod(index + root.draft-count, root.grid-cols) * (root.grid-cell-width + 12px);
                                y: root.group-height + 52px + Math.floor((index + root.draft-count) / root.grid-cols) * 72px;
                                width: root.grid-cell-width; height: 60px; border-radius: Theme.r-card;
                                border-width: root.selected-host == host.id ? 2px : host-touch.has-hover ? 1px : 0px; border-color: root.selected-host == host.id ? Theme.accent : Theme.border;
                                background: Theme.highest;
                                host-touch := TouchArea { width: parent.width; mouse-cursor: pointer;
                                    clicked => { root.selected-host = host.id; root.selected-host-name = host.name; if root.editor-open { root.open-editor(host.id); } else { host-focus.focus(); } }
                                    double-clicked => { root.activate-host(host.id); }
                                    pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.right { root.open-host-menu(host.id, host.name, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
                                }
                                HorizontalLayout { cross-axis-alignment: center; padding: 12px; spacing: 14px;
                                    Rectangle { width: 36px; height: 36px; border-radius: Theme.r-field; background: Theme.tile-host;
                                        Image { source: @image-url("icons/hosts.svg"); colorize: Theme.on-accent; x: 8px; y: 8px; width: 20px; height: 20px; }
                                    }
                                    VerticalLayout { spacing: 3px;
                                        Text { text: host.name; color: Theme.text; font-size: Theme.font-body; font-weight: 500; overflow: elide; }
                                        Text { text: host.tags == "" ? host.address : host.tags + "  ·  " + host.address; color: Theme.secondary; font-size: Theme.font-caption; overflow: elide; }
                                    }
                                    Rectangle { width: 24px; height: 24px; background: transparent; visible: root.selected-host == host.id || host-touch.has-hover || more-touch.has-hover;
                                        Image { colorize: Theme.text; source: @image-url("icons/more.svg"); x: 5px; y: (parent.height - 14px) / 2; width: 14px; height: 14px; }
                                        more-touch := TouchArea {
                                            clicked => { root.open-host-menu(host.id, host.name, self.absolute-position.x - 178px, self.absolute-position.y + 26px); }
                                            pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.right { root.open-host-menu(host.id, host.name, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
                                        }
                                    }
                                }

                            }
                        }
                        if (root.hosts.length > 0 || root.editor-open) && root.host-view-mode == "list": ScrollView {
                            property <int> selection-index: root.host-selection-index;
                            changed selection-index => {
                                if self.selection-index >= 0 {
                                    root.reveal-selection(78px + (root.groups.length > 0 ? 40px + root.groups.length * 46px : 0px) + (self.selection-index + root.draft-count) * 48px, 44px, self.height, self.content-y);
                                    self.content-y = root.selection-scroll-y;
                                }
                            }
                            VerticalLayout { padding-left: 20px; padding-right: 20px; padding-top: 14px; padding-bottom: 24px; spacing: 4px;
                                if root.groups.length > 0: Text { text: @tr("Groups"); color: Theme.text; font-weight: 600; font-size: Theme.font-body; height: 24px; vertical-alignment: center; }
                                for group in root.groups: Rectangle {
                                    height: 42px; border-radius: 8px; background: group-row-touch.has-hover ? Theme.hover : Theme.highest;
                                    group-row-touch := TouchArea { width: parent.width; mouse-cursor: pointer; clicked => { root.host-tag-filter = ""; root.set-host-tag-filter(""); root.search = group.name; root.select-group(group.name); } }
                                    HorizontalLayout { cross-axis-alignment: center; padding-left: 12px; padding-right: 8px; spacing: 10px;
                                        Rectangle { width: 28px; height: 28px; border-radius: 7px; background: Theme.tile-host;
                                            Image { colorize: Theme.on-accent; source: @image-url("icons/hosts.svg"); x: 6px; y: 6px; width: 16px; height: 16px; }
                                        }
                                        Text { text: group.name; color: Theme.text; font-size: Theme.font-body; font-weight: 500; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                        Text { text: group.count + (group.count == 1 ? @tr(" host") : @tr(" hosts")); color: Theme.secondary; font-size: Theme.font-caption; vertical-alignment: center; }
                                        Rectangle { width: 24px; height: 24px; background: transparent; visible: group-row-touch.has-hover || group-row-more.has-hover;
                                            Image { colorize: Theme.text; source: @image-url("icons/more.svg"); x: 5px; y: (parent.height - 14px) / 2; width: 14px; height: 14px; }
                                            group-row-more := TouchArea { clicked => { root.group-rename-old = group.name; root.group-rename-value = group.name; root.group-rename-open = true; } }
                                        }
                                    }

                                }
                                if root.groups.length > 0: Rectangle { height: 8px; background: transparent; }
                                HorizontalLayout { height: 26px; spacing: 8px;
                                    Text { text: @tr("Hosts"); color: Theme.text; font-weight: 600; font-size: Theme.font-body; vertical-alignment: center; }
                                    if root.host-tag-filter != "": Rectangle { width: 150px; height: 24px; border-radius: 6px; background: Theme.accent-soft;
                                        HorizontalLayout { cross-axis-alignment: center; padding-left: 8px; padding-right: 4px; spacing: 4px;
                                            Text { text: @tr("#") + root.host-tag-filter; color: Theme.accent; font-size: Theme.font-caption; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                            Text { text: @tr("×"); color: Theme.accent; font-size: Theme.font-mono; vertical-alignment: center; }
                                        }
                                        TouchArea { clicked => { root.host-tag-filter = ""; root.set-host-tag-filter(""); } }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }
                                Rectangle { height: Theme.table-header-height; background: Theme.high; border-radius: 6px;
                                    Text { x: 44px; width: parent.width * 0.40 - 54px; text: @tr("Name"); color: Theme.secondary; font-size: Theme.font-caption; vertical-alignment: center; }
                                    Text { x: parent.width * 0.40; width: parent.width * 0.27 - 24px; text: @tr("Address"); color: Theme.secondary; font-size: Theme.font-caption; vertical-alignment: center; }
                                    Text { x: parent.width * 0.67; width: parent.width * 0.17 - 16px; text: @tr("Group"); color: Theme.secondary; font-size: Theme.font-caption; vertical-alignment: center; }
                                    Text { x: parent.width * 0.84; width: parent.width * 0.16 - 38px; text: @tr("Auth"); color: Theme.secondary; font-size: Theme.font-caption; vertical-alignment: center; }
                                }
                                if root.draft-count > 0: Rectangle { height: 44px; border-radius: 8px; border-width: 2px; border-color: Theme.accent; background: Theme.highest;
                                    Image { colorize: Theme.text; x: 14px; y: 13px; width: 18px; height: 18px; source: @image-url("icons/hosts.svg"); }
                                    Text { x: 44px; width: parent.width * 0.40 - 54px; text: root.draft.name != "" ? root.draft.name : root.draft.host != "" ? root.draft.host : @tr("Enter IP or Hostname..."); color: Theme.text; vertical-alignment: center; overflow: elide; }
                                    Text { x: parent.width * 0.40; width: parent.width * 0.27 - 24px; text: @tr("ssh"); color: Theme.secondary; font-size: Theme.font-caption; vertical-alignment: center; }
                                }
                                for host in root.hosts: Rectangle {
                                    height: 44px; border-radius: 8px;
                                    border-width: root.selected-host == host.id ? 2px : 0px; border-color: Theme.accent;
                                    background: root.selected-host == host.id ? Theme.accent-soft : host-row-touch.has-hover ? Theme.hover : Theme.highest;
                                    host-row-touch := TouchArea { width: parent.width; mouse-cursor: pointer;
                                        clicked => { root.selected-host = host.id; root.selected-host-name = host.name; if root.editor-open { root.open-editor(host.id); } else { host-focus.focus(); } }
                                        double-clicked => { root.activate-host(host.id); }
                                        pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.right { root.open-host-menu(host.id, host.name, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
                                    }
                                    Image { colorize: Theme.text; x: 14px; y: 13px; width: 18px; height: 18px; source: @image-url("icons/hosts.svg"); }
                                    Text { x: 44px; width: parent.width * 0.40 - 54px; text: host.name; color: Theme.text; font-size: Theme.font-body; font-weight: 500; vertical-alignment: center; overflow: elide; }
                                    Text { x: parent.width * 0.40; width: parent.width * 0.27 - 24px; text: host.address; color: Theme.secondary; font-size: Theme.font-caption; vertical-alignment: center; overflow: elide; }
                                    Text { x: parent.width * 0.67; width: parent.width * 0.17 - 16px; text: host.group; color: Theme.secondary; font-size: Theme.font-caption; vertical-alignment: center; overflow: elide; }
                                    Text { x: parent.width * 0.84; width: parent.width * 0.16 - 38px; text: host.auth; color: Theme.secondary; font-size: Theme.font-caption; vertical-alignment: center; overflow: elide; }
                                    Rectangle { x: parent.width - 32px; y: 7px; width: 26px; height: 30px; background: transparent; visible: host-row-touch.has-hover || host-row-more.has-hover;
                                        Image { colorize: Theme.text; source: @image-url("icons/more.svg"); x: 6px; y: 8px; width: 14px; height: 14px; }
                                        host-row-more := TouchArea {
                                            clicked => { root.open-host-menu(host.id, host.name, self.absolute-position.x - 180px, self.absolute-position.y + 28px); }
                                            pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.right { root.open-host-menu(host.id, host.name, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
                                        }
                                    }

                                }
                            }
                        }
                    }
                    if root.hosts-page && root.section == "keychain": KeychainPage { vertical-stretch: 1; }
                    if root.hosts-page && root.section == "snippets": SnippetsPage { vertical-stretch: 1; }
                    if root.hosts-page && root.section == "known-hosts": KnownHostsPage { vertical-stretch: 1; }
                    if root.hosts-page && root.section == "logs": LogsPage { vertical-stretch: 1; }
                    if root.hosts-page && root.section == "settings": SettingsPage { vertical-stretch: 1; }
                    if root.hosts-page && root.section == "gallery": GalleryPage { vertical-stretch: 1; }
                    if !root.hosts-page: Rectangle { height: root.session-bar-height; background: Theme.high;
                        Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.divider; }
                        HorizontalLayout { cross-axis-alignment: center; padding-left: 12px; padding-right: 12px; spacing: 10px;
                            if root.local-session: Badge { text: @tr("Local"); }
                            if !root.local-session: Segmented {
                                segment-min-width: 84px; options: [@tr("Terminal"), @tr("SFTP")]; current-index <=> root.session-view-index;
                                changed(index) => { root.session-sftp(index == 1); if index == 0 { terminal-focus.focus(); } }
                            }
                            Text { text: root.active-host; color: Theme.secondary; font-size: Theme.font-caption; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        }
                    }
                    HorizontalLayout { visible: !root.hosts-page; min-height: 0px; max-height: root.hosts-page ? 0px : 100000px; vertical-stretch: root.hosts-page ? 0 : 1; spacing: 0px;
                        terminal-area := Rectangle { horizontal-stretch: 1; background: root.terminal-background; clip: true;
                            for run in root.terminal-runs: Rectangle {
                                x: 10px + run.col * root.cell-advance; y: 8px + run.row * root.cell-height-px; width: run.width * root.cell-advance; height: root.cell-height-px; background: run.bg;
                                Text { text: run.text; color: run.fg; font-family: root.terminal-font; font-size: root.terminal-font-size; font-weight: run.bold ? 700 : 400; height: parent.height; vertical-alignment: center; }
                                if run.underline: Rectangle { y: parent.height - 2px; height: 1px; background: run.fg; }
                            }
                            for selection in root.selection-runs: Rectangle { x: 10px + selection.col * root.cell-advance; y: 8px + selection.row * root.cell-height-px; width: selection.width * root.cell-advance; height: root.cell-height-px; background: Theme.terminal-selection; }
                            if root.cursor-visible && root.terminal-visible && (!root.terminal-cursor-blink || root.cursor-phase): Rectangle { x: 10px + root.cursor-col * root.cell-advance; y: 8px + root.cursor-row * root.cell-height-px; width: root.cell-advance; height: root.cell-height-px; background: root.terminal-cursor; }
                            if root.bell-flash: Rectangle { width: parent.width; height: parent.height; background: Theme.accent-soft; }
                            // TextInput enables the native IME. Ordinary keys are consumed below;
                            // composition commits bypass key-pressed and arrive through edited.
                            terminal-focus := TextInput {
                                x: 10px + root.cursor-col * root.cell-advance; y: 8px + root.cursor-row * root.cell-height-px;
                                width: Math.max(1px, parent.width - self.x); height: root.cell-height-px;
                                font-family: root.terminal-font; font-size: root.terminal-font-size; single-line: true; opacity: 0;
                                edited => { if self.text != "" { root.terminal-ime(self.text); self.text = ""; } }
                                key-pressed(event) => {
                                    root.terminal-key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
                                    accept
                                }
                                key-released(event) => { accept }
                            }
                            TouchArea {
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down { terminal-focus.focus(); }
                                    root.terminal-pointer(event.kind == PointerEventKind.down ? 0 : event.kind == PointerEventKind.up ? 1 : event.kind == PointerEventKind.move ? 2 : 3,
                                        event.button == PointerEventButton.left ? 0 : event.button == PointerEventButton.right ? 1 : event.button == PointerEventButton.middle ? 2 : -1,
                                        Math.floor((self.mouse-y - 8px) / root.cell-height-px), Math.floor((self.mouse-x - 10px) / root.cell-advance),
                                        event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
                                }
                                scroll-event(event) => { root.terminal-wheel(Math.floor((self.mouse-y - 8px) / root.cell-height-px), Math.floor((self.mouse-x - 10px) / root.cell-advance), Math.round(event.delta-y / root.cell-height-px), event.modifiers.control, event.modifiers.alt, event.modifiers.shift); accept }
                            }
                            if root.reconnect-hint: Rectangle { x: 16px; y: parent.height - 56px; width: Math.min(420px, parent.width - 32px); height: 40px; background: Theme.tab-bg; border-radius: 6px;
                                Text { text: @tr("Press Enter to reconnect"); color: Theme.warning; font-size: Theme.font-body; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.reconnect-session(root.active-session); terminal-focus.focus(); } }
                            }
                        }
                    }
                }
            }
            Rectangle { width: root.editor-open ? 340px : 0px; background: Theme.base; }
        }
        Rectangle { height: root.status-error || !root.hosts-page ? Theme.statusbar-height : 0px; background: Theme.high; clip: true;
            Rectangle { x: 0px; y: 0px; height: 1px; width: 100%; background: Theme.divider; }
            Text { x: 14px; width: parent.width - 28px; text: root.status-text; color: root.status-error ? Theme.danger : Theme.secondary; font-size: Theme.font-caption; overflow: elide; vertical-alignment: center; }
        }
    }
    if root.sftp-page: Rectangle {
        x: Theme.sidebar-width + 1px; y: Theme.titlebar-height + (root.hosts-page ? 0px : root.session-bar-height);
        width: root.width - self.x; height: root.height - self.y - Theme.statusbar-height; background: Theme.base;
        VerticalLayout { spacing: 0px;
            HorizontalLayout { spacing: 0px;
                Rectangle { width: (parent.width - 1px) / 2; clip: true; background: Theme.highest;
                    VerticalLayout { spacing: 0px;
                        Rectangle { height: 44px; background: Theme.high;
                            HorizontalLayout { cross-axis-alignment: center; padding-left: 12px; padding-right: 12px; spacing: 8px;
                                Rectangle { width: 24px; height: 24px; border-radius: 8px; background: Theme.tile-host;
                                    Image { source: @image-url("icons/local-filled.svg"); colorize: Theme.on-accent; x: 5px; y: 5px; width: 14px; height: 14px; }
                                }
                                Text { text: @tr("Local"); color: Theme.text; font-weight: 500; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                Action { text: root.show-hidden ? @tr("Hidden: shown") : @tr("Hidden: off"); kind: "flat"; text-size: 12px; clicked => { root.show-hidden = !root.show-hidden; SettingsBridge.apply(); root.update-file-view(); } }
                                Action { text: @tr("Actions"); kind: "flat"; has-icon: true; icon: @image-url("icons/chevron-down.svg"); clicked => { root.file-actions-pane = 1; root.file-actions-x = self.absolute-position.x; root.file-actions-y = self.absolute-position.y + 36px; } }
                            }
                        }
                        Rectangle { height: 44px; background: Theme.high;
                            HorizontalLayout { cross-axis-alignment: center; padding-left: 12px; padding-right: 12px; spacing: 6px;
                                IconButton { icon: @image-url("icons/chevron-left.svg"); size: 24px; clicked => { root.list-local(root.local-path + "/.."); } }
                                Input { compact: true; filled: true; text: root.local-path; accepted => { root.list-local(self.text); } }
                            }
                        }
                        FileTableRow { heading: true; sort-column: root.local-sort; ascending: root.local-ascending; sort(column) => { root.local-ascending = root.local-sort == column ? !root.local-ascending : true; root.local-sort = column; root.update-file-view(); } }
                        ListView {
                            for entry in root.local-files: FileTableRow { file: entry; background: root.local-selection == entry.name ? Theme.accent-soft : local-touch.has-hover ? Theme.hover : transparent;
                                local-touch := TouchArea { clicked => { root.local-selection = entry.name; } double-clicked => { if entry.is-directory { root.list-local(root.local-path + "/" + entry.name); } else { root.upload-local(entry.name); } } }
                            }
                        }
                    }
                }
                Rectangle { width: 1px; background: Theme.divider; }
                Rectangle { width: (parent.width - 1px) / 2; clip: true; background: Theme.highest;
                    VerticalLayout { spacing: 0px;
                        Rectangle { height: 44px; background: Theme.high;
                            HorizontalLayout { cross-axis-alignment: center; padding-left: 12px; padding-right: 12px; spacing: 8px;
                                Rectangle { width: 24px; height: 24px; border-radius: 8px; background: Theme.tile-host;
                                    Image { source: @image-url("icons/hosts.svg"); colorize: Theme.on-accent; x: 5px; y: 5px; width: 14px; height: 14px; }
                                }
                                Text { text: root.remote-connected ? root.active-host : @tr("Remote"); color: Theme.text; font-weight: 500; overflow: elide; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                Action { text: @tr("Actions"); kind: "flat"; has-icon: true; icon: @image-url("icons/chevron-down.svg"); disabled: !root.remote-connected; clicked => { root.file-actions-pane = 2; root.file-actions-x = self.absolute-position.x; root.file-actions-y = self.absolute-position.y + 36px; } }
                            }
                        }
                        if root.remote-connected: Rectangle { height: 44px; background: Theme.high;
                            HorizontalLayout { cross-axis-alignment: center; padding-left: 12px; padding-right: 12px; spacing: 6px;
                                IconButton { icon: @image-url("icons/chevron-left.svg"); size: 24px; clicked => { root.list-files(root.file-path + "/.."); } }
                                Input { compact: true; filled: true; text: root.file-path; accepted => { root.list-files(self.text); } }
                            }
                        }
                        if root.remote-connected: FileTableRow { heading: true; remote: true; sort-column: root.remote-sort; ascending: root.remote-ascending; sort(column) => { root.remote-ascending = root.remote-sort == column ? !root.remote-ascending : true; root.remote-sort = column; root.update-file-view(); } }
                        if root.remote-connected: ListView {
                            for entry in root.files: FileTableRow { file: entry; remote: true; background: root.remote-selection == entry.name ? Theme.accent-soft : remote-touch.has-hover ? Theme.hover : transparent;
                                remote-touch := TouchArea { clicked => { root.remote-selection = entry.name; } double-clicked => { if entry.is-directory { root.list-files(root.file-path + "/" + entry.name); } else { root.download-to-local(entry.name); } } }
                            }
                        }
                        if !root.remote-connected: EmptyState { vertical-stretch: 1; background: Theme.base;
                            icon: @image-url("icons/folder-filled.svg"); title: @tr("Not connected");
                            description: @tr("Reconnect this session to browse its files."); action-text: @tr("Reconnect");
                            action-visible: root.active-session != "";
                            action-clicked => { root.reconnect-session(root.active-session); }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.divider; }
            Rectangle { height: root.transfers.length > 0 ? 154px : 46px; background: Theme.high; clip: true;
                VerticalLayout { padding: 8px; spacing: 4px;
                    HorizontalLayout { cross-axis-alignment: center; spacing: 8px;
                        Text { text: @tr("Transfers"); font-weight: 600; color: Theme.text; vertical-alignment: center; }
                        Text { text: @tr("8 queued maximum"); color: Theme.secondary; font-size: Theme.font-caption; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Action { text: @tr("Upload file"); kind: "flat"; text-size: 12px; disabled: !root.remote-connected; clicked => { root.upload-file(); } }
                        Action { text: @tr("Upload folder"); kind: "flat"; text-size: 12px; disabled: !root.remote-connected; clicked => { root.upload-folder(); } }
                    }
                    if root.transfers.length > 0: ListView {
                        for transfer in root.transfers: Rectangle { height: 52px;
                            HorizontalLayout { cross-axis-alignment: center; spacing: 12px;
                                VerticalLayout { horizontal-stretch: 1; spacing: 2px;
                                    Text { text: transfer.name; color: Theme.text; font-size: Theme.font-body; font-weight: 500; overflow: elide; }
                                    Text { text: transfer.detail; color: Theme.secondary; font-size: Theme.font-caption; overflow: elide; }
                                    Rectangle { height: 3px; background: Theme.border; Rectangle { x: 0px; y: 0px; height: parent.height; width: parent.width * Math.max(0, Math.min(100, transfer.percent)) / 100; background: Theme.accent; } }
                                }
                                Action { kind: "secondary"; horizontal-stretch: 0; text: @tr("Cancel"); text-size: 12px; disabled: !transfer.pending; clicked => { root.cancel-transfer(transfer.id); } }
                            }
                        }
                    }
                }
            }
            Rectangle { height: 28px; background: Theme.high; clip: true;
                Rectangle { x: 0px; y: 0px; width: 100%; height: 1px; background: Theme.divider; }
                Text { x: 12px; width: parent.width - 24px; text: root.status-text; color: root.status-error ? Theme.danger : Theme.secondary; font-size: Theme.font-caption; overflow: elide; vertical-alignment: center; }
            }
        }
    }
    if root.file-actions-pane != 0: Popover { open: true; anchor-x: Math.min(root.file-actions-x, root.width - 208px); anchor-y: root.file-actions-y;
        dismissed => { root.file-actions-pane = 0; }
        MenuItem { text: @tr("Refresh"); clicked => { if root.file-actions-pane == 1 { root.list-local(root.local-path); } else { root.list-files(root.file-path); } root.file-actions-pane = 0; } }
        MenuItem { text: @tr("New folder"); clicked => { root.file-dialog-local = root.file-actions-pane == 1; root.file-dialog-source = ""; root.file-dialog-value = ""; root.file-actions-pane = 0; root.file-dialog = "mkdir"; } }
        MenuItem { text: @tr("Rename"); enabled: root.file-actions-pane == 1 ? root.local-selection != "" : root.remote-selection != "";
            clicked => { root.file-dialog-local = root.file-actions-pane == 1; root.file-dialog-source = root.file-dialog-local ? root.local-selection : root.remote-selection; root.file-dialog-value = root.file-dialog-source; root.file-actions-pane = 0; root.file-dialog = "rename"; }
        }
        MenuItem { text: root.file-actions-pane == 1 ? @tr("Upload") : @tr("Download"); enabled: root.remote-connected && (root.file-actions-pane == 1 ? root.local-selection != "" : root.remote-selection != "");
            clicked => { if root.file-actions-pane == 1 { root.upload-local(root.local-selection); } else { root.download-to-local(root.remote-selection); } root.file-actions-pane = 0; }
        }
        MenuSeparator { }
        MenuItem { text: @tr("Delete"); danger: true; enabled: root.file-actions-pane == 1 ? root.local-selection != "" : root.remote-selection != "";
            clicked => { root.file-operation(root.file-actions-pane == 1, "delete", root.file-actions-pane == 1 ? root.local-selection : root.remote-selection, ""); root.file-actions-pane = 0; }
        }
    }
    if root.file-dialog != "": Dialog { open: true; title: (root.file-dialog-local ? @tr("Local / ") : @tr("Remote / ")) + (root.file-dialog == "mkdir" ? @tr("New folder") : @tr("Rename")); confirm-text: @tr("Save"); confirm-enabled: root.file-dialog-value != "";
        Input { filled: true; text <=> root.file-dialog-value; placeholder-text: @tr("Name"); init => { self.focus(); } }
        cancel => { root.file-dialog = ""; }
        confirm => { root.file-operation(root.file-dialog-local, root.file-dialog, root.file-dialog-source, root.file-dialog-value); root.file-dialog = ""; }
    }
    if root.group-editing: TouchArea { clicked => { root.group-editing = false; } }
    if root.editor-open: Rectangle { x: root.width - Theme.panel-width; y: Theme.titlebar-height; width: Theme.panel-width; height: root.height - Theme.titlebar-height - (root.status-error ? Theme.statusbar-height : 0px); background: Theme.base;
        Rectangle { background: Theme.base;
            Timer { interval: 16ms; running: root.editor-focus-requested; triggered => { address-input.focus(); editor-scroll.content-y = 0px; root.editor-focus-requested = false; } }
            VerticalLayout { padding: 0px; spacing: 0px;
                Rectangle { height: Theme.header-height; background: Theme.high;
                    HorizontalLayout { cross-axis-alignment: center; padding-left: 20px; padding-right: 14px; spacing: 10px;
                        Text { text: root.creating-host ? @tr("New Host") : @tr("Host Details"); color: Theme.text; font-size: Theme.font-body; font-weight: 600; vertical-alignment: center; }
                        IconButton { icon: @image-url("icons/more.svg"); clicked => { root.editor-menu-open = !root.editor-menu-open; } }
                        IconButton { icon: @image-url("icons/collapse-right.svg"); glyph-size: 18px; clicked => { if root.draft.host == "" || root.save-host(root.draft) { root.close-editor(); } } }
                    }
                }
                editor-scroll := ScrollView { VerticalLayout { padding: 15px; spacing: 15px;
                    Card { title: @tr("Address"); height: 102px;
                            HorizontalLayout { cross-axis-alignment: center; spacing: 10px;
                                Rectangle { width: 36px; height: 36px; border-radius: 8px; background: Theme.tile-host;
                                    Image { source: @image-url("icons/hosts.svg"); colorize: Theme.on-accent; x: 8px; y: 8px; width: 20px; height: 20px; }
                                }
                                address-input := Input { placeholder-text: @tr("IP or Hostname"); text <=> root.draft.host; }
                            }
                    }
                    Card { title: @tr("General");
                            Input { placeholder-text: @tr("Label"); text <=> root.draft.name; }
                            group-input := Input { placeholder-text: @tr("Parent Group"); text <=> root.draft.group; has-leading-icon: true; leading-icon: @image-url("icons/group.svg"); edited => { root.group-suggestions = root.suggest-host-groups(self.text); root.group-editing = true; } accepted => { root.group-editing = false; } }
                            Input { placeholder-text: @tr("Tags (comma separated)"); text <=> root.draft.tags; has-leading-icon: true; leading-icon: @image-url("icons/tag.svg"); }
                            HorizontalLayout { cross-axis-alignment: center; spacing: 8px; Text { text: @tr("Backspace"); color: Theme.secondary; font-size: Theme.font-caption; } Select { options: [@tr("Default")]; current-index: 0; enabled: false; } }
                    }
                    Card {
                            HorizontalLayout { cross-axis-alignment: center; spacing: 4px; alignment: start;
                                Text { text: @tr("SSH on"); color: Theme.text; font-size: Theme.font-body; font-weight: 500; vertical-alignment: center; }
                                Input { placeholder-text: @tr("22"); text <=> root.draft.port; compact: true; min-width: 80px; max-width: 80px; }
                                Text { text: @tr("port"); color: Theme.text; font-size: Theme.font-body; font-weight: 500; vertical-alignment: center; }
                            }
                            Rectangle { height: 1px; background: Theme.divider; }
                            Text { text: @tr("Credentials"); color: Theme.text; font-size: Theme.font-body; font-weight: 600; height: 20px; }
                            Input { placeholder-text: @tr("Username"); text <=> root.draft.username; has-leading-icon: true; leading-icon: @image-url("icons/user.svg"); }
                            HorizontalLayout { cross-axis-alignment: center; spacing: 8px;
                                Action { text: @tr("Password"); kind: root.draft.auth-index == 0 ? "primary" : "secondary"; horizontal-stretch: 1; clicked => { root.draft.auth-index = 0; root.draft.key-id = ""; } }
                                Action { text: @tr("Key"); kind: root.draft.auth-index == 1 ? "primary" : "secondary"; horizontal-stretch: 1; clicked => { root.draft.auth-index = 1; } }
                            }
                            if root.draft.key-id == "": Input { placeholder-text: root.draft.auth-index == 1 ? @tr("Passphrase") : @tr("Password"); input-type: InputType.password; text <=> root.draft.secret; has-leading-icon: true; leading-icon: @image-url("icons/password.svg"); }
                            if root.draft.auth-index == 1: VerticalLayout { spacing: 8px;
                                if KeychainBridge.keys.length > 0: VerticalLayout { spacing: 4px;
                                    Text { text: @tr("Keychain"); color: Theme.secondary; font-size: Theme.font-caption; height: 16px; }
                                    Rectangle { height: Math.min(KeychainBridge.keys.length, 3) * 38px; background: Theme.base; border-radius: 8px; border-width: 1px; border-color: Theme.border;
                                        ScrollView { VerticalLayout { for key in KeychainBridge.keys: Rectangle { height: 38px; background: root.draft.key-id == key.id ? Theme.accent-soft : transparent;
                                            HorizontalLayout { cross-axis-alignment: center; padding-left: 8px; padding-right: 8px; spacing: 8px;
                                                Image { source: @image-url("icons/keychain.svg"); colorize: root.draft.key-id == key.id ? Theme.accent : Theme.secondary; width: 15px; height: 15px; }
                                                VerticalLayout { spacing: 1px;
                                                    Text { text: key.label; color: Theme.text; font-size: Theme.font-mono; overflow: elide; }
                                                    Text { text: key.fingerprint; color: Theme.secondary; font-size: Theme.font-caption; overflow: elide; }
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                                if root.draft.key-id == key.id: Text { text: @tr("✓"); color: Theme.accent; vertical-alignment: center; }
                                            }
                                            TouchArea { clicked => { root.draft.key-id = key.id; root.draft.key-path = ""; } }
                                        } } }
                                    }
                                }
                                if KeychainBridge.keys.length == 0: Text { text: @tr("No keys in Keychain. Add one in the Keychain section."); color: Theme.secondary; font-size: Theme.font-caption; wrap: word-wrap; }
                                if root.draft.key-id == "": VerticalLayout { spacing: 8px;
                                    Field { label: @tr("Private key file"); text <=> root.draft.key-path; }
                                    Action { kind: "secondary"; text: @tr("Choose file…"); clicked => { root.draft.key-path = root.pick-key(); } }
                                }
                                if root.draft.key-id != "": Action { text: @tr("Use a key file instead"); kind: "flat"; clicked => { root.draft.key-id = ""; } }
                            }
                    }
                } }
                Rectangle { height: 76px; background: Theme.base;
                    Rectangle { x: 0px; y: 0px; width: 100%; height: 1px; background: Theme.divider; }
                    HorizontalLayout { cross-axis-alignment: center; padding-left: 15px; padding-right: 15px; padding-top: 20px; padding-bottom: 20px; spacing: 10px;
                        Action { text: @tr("Connect"); kind: "primary"; size: "l"; border-radius: Theme.r-field; disabled: root.draft.host == ""; horizontal-stretch: 1; min-height: 36px; max-height: 36px; clicked => { root.save-and-connect(root.draft); } }
                    }
                }
            }
        }
        Rectangle { x: 0px; y: 0px; width: 1px; height: parent.height; background: Theme.divider; }
        // Keep the editable group field focused while suggestions are visible.
        // Popover takes keyboard focus, so autocomplete uses its own themed surface.
        if root.group-editing: Rectangle {
            x: group-input.absolute-position.x - root.width + 340px;
            y: Math.min(group-input.absolute-position.y - 51px + 40px, parent.height - self.height - 12px);
            width: group-input.width; height: Math.min(6, root.group-suggestions.length + 1) * 32px + 8px;
            background: Theme.highest; border-radius: Theme.r-field; border-width: 1px; border-color: Theme.border;
            ScrollView { x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                VerticalLayout { spacing: 0px;
                    MenuItem { text: @tr("No group"); clicked => { root.draft.group = ""; root.group-editing = false; } }
                    for group in root.group-suggestions: MenuItem { text: group.name + " (" + group.count + ")"; clicked => { root.draft.group = group.name; root.group-editing = false; } }
                }
            }
        }
    }
    Popover { open <=> root.editor-menu-open; anchor-x: root.width - 220px; anchor-y: 99px; popover-width: 200px;
        MenuItem { text: @tr("Add Telnet"); enabled: false; }
        MenuItem { text: @tr("Remove"); danger: true; has-icon: true; icon: @image-url("icons/trash.svg"); clicked => { root.editor-menu-open = false; if !root.creating-host { root.ask-delete(root.draft.id, root.draft.name); } else { root.close-editor(); } } }
    }
    Popover { open <=> root.tag-menu-open; anchor-x: Math.max(8px, root.toolbar-popup-x); anchor-y: root.toolbar-popup-y; popover-width: 232px;
        popover-height: Math.min(56px + root.host-tags.length * 32px, root.height - root.toolbar-popup-y - 12px);
        Text { text: @tr("Filter by tag"); color: Theme.secondary; font-size: Theme.font-caption; height: 16px; }
        ScrollView { VerticalLayout { spacing: 0px;
            MenuItem { text: @tr("All hosts"); show-check: root.host-tag-filter == ""; clicked => { root.host-tag-filter = ""; root.set-host-tag-filter(""); root.tag-menu-open = false; } }
            for tag in root.host-tags: MenuItem { text: @tr("#") + tag.name + " (" + tag.count + ")"; show-check: root.host-tag-filter == tag.name; clicked => { root.host-tag-filter = tag.name; root.set-host-tag-filter(tag.name); root.tag-menu-open = false; } }
        } }
    }
    Popover { open <=> root.sort-menu-open; anchor-x: Math.max(8px, root.toolbar-popup-x); anchor-y: root.toolbar-popup-y; popover-width: 222px;
        MenuItem { text: @tr("Name"); show-check: root.host-sort-mode == "name"; clicked => { root.host-sort-mode = "name"; root.set-host-sort("name"); root.sort-menu-open = false; } }
        MenuItem { text: @tr("Last connected"); show-check: root.host-sort-mode == "last"; clicked => { root.host-sort-mode = "last"; root.set-host-sort("last"); root.sort-menu-open = false; } }
        MenuItem { text: @tr("Date created"); show-check: root.host-sort-mode == "created"; clicked => { root.host-sort-mode = "created"; root.set-host-sort("created"); root.sort-menu-open = false; } }
    }
    Popover { open <=> root.host-menu-open;
        anchor-x: Math.max(8px, Math.min(root.host-menu-x, root.width - 218px)); anchor-y: Math.max(58px, Math.min(root.host-menu-y, root.height - 245px)); popover-width: 210px;
        Text { text: root.host-menu-name; color: Theme.secondary; font-size: Theme.font-caption; height: 24px; overflow: elide; }
        MenuSeparator { }
        MenuItem { text: @tr("Connect"); clicked => { root.host-menu-open = false; root.activate-host(root.host-menu-id); } }
        MenuItem { text: @tr("Edit"); clicked => { root.host-menu-open = false; root.selected-host-name = root.host-menu-name; root.open-editor(root.host-menu-id); } }
        MenuItem { text: @tr("Duplicate"); clicked => { root.host-menu-open = false; root.duplicate-host(root.host-menu-id); } }
        MenuItem { text: @tr("Open SFTP"); clicked => { root.host-menu-open = false; if root.save-current-draft() { root.close-editor(); root.open-host-sftp(root.host-menu-id); } } }
        MenuItem { text: @tr("Copy address"); clicked => { root.host-menu-open = false; root.copy-host-address(root.host-menu-id); } }
        MenuSeparator { }
        MenuItem { text: @tr("Delete"); danger: true; clicked => { root.ask-delete(root.host-menu-id, root.host-menu-name); } }
    }
    if root.tab-menu-session != "": Popover { open: true; dismissed => { root.tab-menu-session = ""; terminal-focus.focus(); }
        anchor-x: Math.min(root.tab-menu-x, root.width - 208px); anchor-y: 45px;
        MenuItem { text: @tr("Reconnect"); enabled: root.tab-menu-reconnectable; clicked => { root.reconnect-session(root.tab-menu-session); root.tab-menu-session = ""; } }
        MenuItem { text: @tr("Duplicate session"); clicked => { root.duplicate-session(root.tab-menu-session); root.tab-menu-session = ""; } }
        MenuItem { text: @tr("Close"); danger: true; clicked => { root.close-session(root.tab-menu-session); root.tab-menu-session = ""; terminal-focus.focus(); } }
    }
    Popover { open <=> root.menu-open; anchor-x: 9px; anchor-y: 45px; popover-width: 230px;
        Text { text: @tr("OpenTermius"); color: Theme.secondary; font-size: Theme.font-caption; height: 20px; vertical-alignment: center; }
        MenuItem { text: @tr("Import hosts"); has-icon: true; icon: @image-url("icons/arrow-down.svg"); clicked => { root.menu-open = false; root.import-hosts(); } }
        MenuItem { text: @tr("Import from Xshell"); has-icon: true; icon: @image-url("icons/arrow-down.svg"); clicked => { root.menu-open = false; root.import-xshell(); } }
        MenuItem { text: @tr("Import from WindTerm"); has-icon: true; icon: @image-url("icons/arrow-down.svg"); clicked => { root.menu-open = false; root.import-windterm(); } }
        MenuItem { text: @tr("Export hosts"); has-icon: true; icon: @image-url("icons/arrow-up.svg"); clicked => { root.menu-open = false; root.export-hosts(); } }
        MenuSeparator { }
        MenuItem { text: @tr("Backup & Restore"); has-icon: true; icon: @image-url("icons/keychain.svg"); clicked => { root.menu-open = false; root.open-section("recovery"); } }
        MenuItem { text: @tr("Settings"); has-icon: true; icon: @image-url("icons/settings.svg"); clicked => { root.menu-open = false; root.open-section("settings"); } }
    }
    Dialog { open <=> root.delete-open; title: @tr("Delete host?"); description: @tr("Remove \"") + root.delete-name + @tr("\"? This cannot be undone."); confirm-text: @tr("Delete"); confirm-kind: "danger";
        confirm => { if root.editor-open && root.draft.id == root.delete-id { root.close-editor(); } root.delete-host(root.delete-id); root.selected-host = ""; root.selected-host-name = ""; root.delete-open = false; }
    }
    Dialog { open <=> root.group-rename-open; title: @tr("Rename group"); description: @tr("Rename the group and move its hosts with it."); confirm-text: @tr("Rename"); confirm-enabled: root.group-rename-value != "";
        Input { filled: true; text <=> root.group-rename-value; placeholder-text: @tr("Group name"); init => { self.focus(); } }
        confirm => { root.rename-group(root.group-rename-old, root.group-rename-value); root.group-rename-open = false; }
    }
    if RecoveryBridge.visible: Rectangle { background: Theme.scrim;
        TouchArea { }
        RecoveryPanel { width: Math.min(880px, parent.width - 32px); height: Math.min(660px, parent.height - 32px); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
    }
    if root.prompt-visible: Dialog { open: true; title: root.prompt-title; dialog-width: 520px;
        confirm-text: root.prompt-is-key ? @tr("Trust and connect") : @tr("Continue");
        // Rust owns prompt visibility and may replace a cancelled prompt immediately.
        cancel => { self.open = true; root.answer-prompt(false, ""); }
        confirm => { root.answer-prompt(true, root.prompt-answer); }
        Text { text: root.prompt-message; color: Theme.text; wrap: word-wrap; font-size: Theme.font-body; }
        if !root.prompt-is-key: Rectangle { height: Theme.input-height + 2px; background: transparent;
            Input { x: 0px; y: 0px; width: parent.width; height: Theme.input-height; filled: true; text <=> root.prompt-answer; input-type: root.prompt-password ? InputType.password : InputType.text; init => { self.focus(); } }
        }
    }
    }
}
